{
  "id": "/?app=cliente",
  "name": "Baznova Marketplace",
  "short_name": "Baznova",
  "description": "Compra en las tiendas y restaurantes de tu zona, sigue tus pedidos y recibe avisos cuando cambien.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "related_applications": [{ "platform": "webapp", "url": "/manifest-cliente.webmanifest" }],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0e1a28",
  "theme_color": "#0e1a28",
  "categories": [
    "shopping",
    "food"
  ],
  "icons": [
    {
      "src": "/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}