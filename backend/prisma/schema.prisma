generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  // Bloque 183 (pedido explícito — "quiero que el vendedor... pueda crear
  // usuarios con roles dentro de su negocio... solo va a tener acceso a la
  // sección que él designe"): un User real, con su propia sesión/login,
  // pero SIN ser dueño de ninguna tienda — su acceso vive en VendorStaff
  // (a qué vendor pertenece, a qué secciones del panel puede entrar).
  // authenticate()/requireRole() lo tratan como cualquier otro rol; el
  // recorte real de qué puede tocar pasa por requireVendorAccess(section)
  // en las rutas del panel de vendedor, nunca solo en el frontend.
  VENDOR_STAFF
}

enum PlanType {
  REGULAR
  BUSINESS
}

// Bloque 14: consolidado de 4 valores a 3 opciones claras en el checkout
// (antes WHATSAPP/COD/TRANSFER/TABLE). COD y TABLE quedan igual. WHATSAPP
// (el catch-all viejo "coordinar por WhatsApp") pasa a llamarse CASH
// ("Efectivo" — en la práctica siempre terminaba siendo pago en efectivo
// coordinado por chat). TRANSFER (antes específico de CUP/Transfermóvil) se
// generaliza a ONLINE ("Pago en línea con el vendedor" — cualquier método
// electrónico que el cliente arregle directo con la tienda: transferencia,
// Zelle, USDT, etc., ligado a Vendor.acceptedPaymentMethods del Bloque 14).
// Los pedidos históricos con los valores viejos se migran automáticamente
// vía ALTER TYPE ... RENAME VALUE (ver migración) — el valor se guarda por
// OID interno, no por texto, así que ningún pedido existente pierde datos.
enum OrderChannel {
  CASH
  COD
  ONLINE
  TABLE
}

// Preferencia del vendedor: a dónde llegan los pedidos que hace un cliente.
// Bloque 68 (pedido explícito): el checkout con formulario completo ya
// SIEMPRE crea el Order real y cae en /vendedor/pedidos, sin importar este
// valor (antes WHATSAPP dejaba saltarse el formulario entero con un atajo
// directo a wa.me que nunca creaba pedido — ese atajo se eliminó). Ahora
// este campo solo decide qué le ofrece la pantalla de confirmación al
// cliente DESPUÉS de crear el pedido: WHATSAPP = solo ofrece mandarlo por
// WhatsApp; PANEL = no menciona WhatsApp, el vendedor lo gestiona desde su
// panel; BOTH = ofrece las dos cosas (WhatsApp + aviso de que ya quedó en
// su panel).
enum OrderDestination {
  WHATSAPP
  PANEL
  BOTH
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum KitchenStatus {
  RECEIVED
  PREPARING
  READY
}

// Bloque 64 (pedido explícito — bug real reportado en vivo): fuente única de
// verdad del estado de verificación de una tienda. Antes vivía repartido en
// dos lugares que podían desincronizarse (`VerificationRequest.status` +
// `Vendor.isVerified`, este último un booleano guardado aparte) — confirmado
// en la propia base de datos que 5 de 12 tiendas sembradas tenían
// `isVerified:true` sin verificación real completa. Ahora todo el sitio (badge,
// IA, destacado, admin) lee ÚNICAMENTE `Vendor.verificationStatus`.
// NOT_STARTED: nunca inició el trámite (o su VerificationRequest no tiene
// fotos todavía). PENDING_DOCS: documentos subidos, nadie los abrió aún.
// IN_REVIEW: un admin ya abrió la solicitud para revisarla (ver
// admin.controller.js:startVerificationReview). PENDING_PAYMENT: documentos
// aprobados, falta resolver el cobro. VERIFIED: badge activo (docs + cobro
// vigente). PAYMENT_FAILED: estuvo VERIFIED pero el cobro recurrente falló
// (Stripe invoice o vencimiento CUP) — recuperable pagando de nuevo, sin
// rehacer documentos. SUSPENDED: Stripe eliminó la suscripción de verdad
// (`customer.subscription.deleted`) — para volver hace falta una suscripción
// nueva, no solo pagar una factura vencida. REJECTED: documentos rechazados.
enum VendorVerificationStatus {
  NOT_STARTED
  PENDING_DOCS
  IN_REVIEW
  PENDING_PAYMENT
  VERIFIED
  PAYMENT_FAILED
  SUSPENDED
  REJECTED
}

// Bloque 64: de dónde vino cada cambio de estado (VerificationStatusLog) —
// distingue una decisión humana de admin de algo que pasó solo (webhook de
// Stripe o el cron de vencimiento CUP), y de una acción del propio vendedor
// (ej. cancelar su plan).
enum VerificationStatusSource {
  ADMIN_ACTION
  STRIPE_WEBHOOK
  CRON_EXPIRATION
  VENDOR_ACTION
}

// Cómo eligió pagar el vendedor la suscripción una vez aprobados sus
// documentos — determina si la activación final es automática (tarjeta, vía
// link con confirmación real del proveedor) o manual (transferencia CUP,
// nadie puede confirmarla sola, la aprueba un admin a mano).
enum VerificationPaymentMethod {
  CARD
  CUP_TRANSFER
}

// Bloque 66 (pedido explícito): qué tipo de documento de identidad subió el
// vendedor en la verificación — antes se asumía siempre carné de identidad
// cubano; ahora el vendedor elige cuál de los tres presenta (idPhotoBackUrl
// queda opcional en el controller cuando es PASSPORT, que no tiene reverso).
enum IdDocumentType {
  NATIONAL_ID
  PASSPORT
  INTERNATIONAL_ID
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
}

enum EmailType {
  ORDER_CONFIRMATION
  STATUS_UPDATE
  MANUAL
  PASSWORD_RESET
  // Bloque 47: código de 2FA del login — mismo criterio que PASSWORD_RESET
  // (tipo propio, no genérico), nunca el mismo enum value pese a compartir
  // la forma "código de 6 dígitos por correo".
  TWO_FACTOR_CODE
  // Bloque 48: mensaje del formulario de /contacto — va al correo del
  // primer admin (no hay multi-admin todavía, ver Bloque 47 decisión D).
  CONTACT_MESSAGE
  // Bloque 16: un solo tipo genérico para todo el ciclo de verificación
  // (docs aprobados/rechazados, link de pago, verificado) — mismo patrón que
  // STATUS_UPDATE ya usa un label map en vez de un enum-value por estado.
  VERIFICATION_UPDATE
  TABLE_ORDER_STATUS
  // Bloque 29: envío de factura/garantía en PDF — tipo propio (no MANUAL)
  // porque es un documento generado por el sistema, no texto libre del
  // vendedor, y no debe contar contra su límite mensual de emails manuales
  // (es una necesidad operativa básica, no un extra de marketing).
  DOCUMENT
  // Bloque 59: código de verificación previo a crear la cuenta (cliente o
  // vendedor) — mismo criterio que TWO_FACTOR_CODE, tipo propio pese a
  // compartir la forma "código de 6 dígitos por correo".
  REGISTRATION_CODE
  // Bloque 62: ciclo de vida de inactividad de la tienda (recordatorio de 7
  // días, suspensión automática a los 90, reactivación por un admin) y
  // re-enganche de clientes que compraron una sola vez — 4 tipos propios,
  // ninguno cuenta contra el límite mensual de MANUAL del vendedor (son
  // necesidad operativa/de la plataforma, no marketing suyo).
  VENDOR_INACTIVITY_REMINDER
  VENDOR_SUSPENDED
  VENDOR_WINBACK
  VENDOR_REACTIVATED
  // Bloque 64: aviso proactivo (no es un cambio de estado en sí, a diferencia
  // de VERIFICATION_UPDATE que sí cubre esos) — 7 días antes de que venza el
  // ciclo de pago CUP recurrente.
  VERIFICATION_PAYMENT_REMINDER
  // Bloque 71: código de verificación para cambiar el correo de la cuenta —
  // mismo criterio que TWO_FACTOR_CODE/REGISTRATION_CODE (tipo propio).
  EMAIL_CHANGE_CODE
  // Feature B (pedido explícito): reportes de fraude sobre producto/tienda/
  // venta rápida — 3 tipos propios, mismo criterio que el resto del enum
  // (nunca reusar MANUAL, no deben contar contra el límite mensual del
  // vendedor porque no las inició él).
  FRAUD_REPORT_EVIDENCE_REQUESTED
  FRAUD_REPORT_DISMISSED
  FRAUD_REPORT_SUSPENDED
  // Bloque 183: aviso al usuario de sistema recién creado (ver
  // vendorStaff.controller.js) de que ya tiene una cuenta esperándolo.
  VENDOR_STAFF_INVITE
  // Bloque 194 (pedido explícito — "notificación por correo... para
  // notificar sobre bajo stock en productos antes que se agoten"): aviso
  // operativo automático (lowStock.job.js), no cuenta contra el límite
  // mensual de MANUAL del vendedor — mismo criterio que el resto del enum.
  LOW_STOCK_ALERT
  // Bloque 198 (pedido explícito — "se enviará un correo a los usuarios que
  // ese día tienen que ir y reportar todas las ventas"): aviso operativo
  // automático (cashCloseReminder.job.js), mismo criterio que
  // LOW_STOCK_ALERT — no cuenta contra el límite mensual de MANUAL.
  CASH_CLOSE_REMINDER
  // Bloque 211 (pedido explícito — auto-eliminación de cuenta con 30 días de
  // gracia): 4 tipos propios, ninguno cuenta contra el límite mensual de
  // MANUAL del vendedor (son necesidad operativa/de la plataforma, mismo
  // criterio que el resto del enum).
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETION_REMINDER
  ACCOUNT_DELETION_REACTIVATED
  ACCOUNT_DELETION_COMPLETED
}

enum EmailStatus {
  SENT
  FAILED
}

// Bloque 33: origen de un ErrorLog — un valor fijo por punto de falla ya
// cubierto (bots, email, stripe, transcripción) más OTRO para cualquier
// error no anticipado que llegue al errorHandler central.
enum ErrorOrigin {
  BOT_TIENDA
  BOT_GENERAL
  EMAIL_RESEND
  STRIPE
  TRANSCRIPCION_AUDIO
  // Bloque 85: verificación diaria automática de los proveedores de IA
  // (aiHealthCheck.job.js) — un modelo dado de baja o un proveedor entero
  // sin responder, distinto de BOT_TIENDA/BOT_GENERAL (esos son fallos en
  // vivo de una charla real, este es el chequeo programado de fondo).
  AI_HEALTH_CHECK
  OTRO
}

// Bloque 37: cuál de los dos bots — mismo criterio que ErrorOrigin (valor
// fijo por punto conocido, sin mezclar con el resto del sistema).
enum ChatBotType {
  TIENDA
  GENERAL
}

// ---------------------------------------------------------------------------
// Ubicación (por ahora solo Cuba: provincias / municipios / adyacencias) —
// Bloque 18: el admin puede agregar más países/provincias/municipios desde
// AdminLocations.jsx sin tocar código, aunque el checkout de compra sigue
// mostrando "Cuba" fijo como único destino de entrega por ahora.
// ---------------------------------------------------------------------------

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  provinces Province[]
  vendorDeliveries VendorDeliveryCountry[]
  // Bloque 66: tiendas cuyo país de registro LEGAL es este (Vendor.registrationCountryId).
  vendorsRegisteredHere Vendor[]
  // Bloque 113: clientes/vendedores cuyo país de REGISTRO (persona, no
  // tienda) es este (User.registrationCountryId).
  registeredUsers User[]
  // Bloque 114: ubicaciones de tienda (VendorLocation) fuera de Cuba, donde
  // ya no hay una Province real y este es el único vínculo al catálogo.
  vendorLocations VendorLocation[]
}

// Países a los que un vendedor puntual entrega (además/aparte de las
// provincias de Cuba donde vende — ver VendorLocation). Solo países con
// Country.isActive:true son elegibles; el admin nunca borra un país con
// vendedores usándolo directamente, lo desactiva (mismo criterio que
// BusinessCategory). El límite de cuántos puede tener cada vendedor según
// su plan vive en SiteSettings (maxDeliveryCountriesRegular/Business),
// configurable desde AdminLocations.jsx — nunca hardcodeado en el código.
model VendorDeliveryCountry {
  id        String   @id @default(cuid())
  vendorId  String
  countryId String
  createdAt DateTime @default(now())

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([vendorId, countryId])
}

model Province {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  type     String  @default("PROVINCE") // "PROVINCE" o "STATE"
  isActive Boolean @default(true)

  // Nullable a propósito: las provincias ya sembradas se backfillean a
  // Cuba, pero no hace falta una migración estricta que rompa si algún día
  // queda una fila sin país asignado todavía.
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  municipalities Municipality[]
  vendorLocations VendorLocation[]
  addresses      Address[]
  users          User[]
  // Bloque 66: tiendas cuya provincia de registro LEGAL es esta (Vendor.legalProvinceId).
  vendorsLegal   Vendor[]

  adjacentTo   ProvinceAdjacency[] @relation("ProvinceA")
  adjacentFrom ProvinceAdjacency[] @relation("ProvinceB")
}

model Municipality {
  id         String   @id @default(cuid())
  provinceId String
  name       String
  isActive   Boolean  @default(true)
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  vendorLocations VendorLocation[]
  addresses       Address[]
  // Bloque 66: tiendas cuyo municipio de registro LEGAL es este (Vendor.legalMunicipalityId).
  vendorsLegal    Vendor[]
  // Bloque 113: clientes/vendedores cuyo municipio de REGISTRO (persona, no
  // tienda) es este (User.municipalityId).
  users           User[]

  @@unique([provinceId, name])
}

// Provincias vecinas, usada para recomendar productos cercanos cuando no hay
// stock local (ver search.controller). Se guarda en ambos sentidos.
model ProvinceAdjacency {
  id          String @id @default(cuid())
  provinceAId String
  provinceBId String

  provinceA Province @relation("ProvinceA", fields: [provinceAId], references: [id], onDelete: Cascade)
  provinceB Province @relation("ProvinceB", fields: [provinceBId], references: [id], onDelete: Cascade)

  @@unique([provinceAId, provinceBId])
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]
  vendors  Vendor[] @relation("VendorCategory")
}

// Bloque 18: catálogo de "tipo de negocio" administrable por el admin — NO
// es lo mismo que Category de arriba (esa es de producto/rubro heredada de
// bloques anteriores, se deja intacta). Cada tienda elige UNA de estas al
// registrarse (ver Vendor.businessCategoryId) y puede cambiarla después
// desde VendorSettings.jsx. "Todos" nunca es una fila acá — es solo la
// opción de filtro sin filtro real en el frontend.
model BusinessCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  vendors Vendor[]
}

model Product {
  id          String   @id @default(cuid())
  vendorId    String
  categoryId  String?
  name        String
  slug        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  oldPrice    Decimal? @db.Decimal(12, 2)
  // Bloque 52: en qué moneda están price/oldPrice — puramente informativo
  // (no hay conversión/tipo de cambio en el sistema), el vendedor elige una
  // sola por producto al cargarlo. Default CUP para no alterar el
  // comportamiento de los productos ya cargados al desplegar la migración.
  currency    ProductCurrency @default(CUP)
  stock       Int      @default(0)
  // Bloque 56 (pedido explícito): hay vendedores que no tienen un stock
  // acotado real (servicios, productos que siempre reponen al toque, etc.) —
  // con esto en true, `stock` deja de usarse para disponibilidad/descuento en
  // TODO el sistema (carrito, checkout, confirmación de venta, dashboard de
  // bajo stock/agotado): el producto se muestra siempre disponible y nunca se
  // le hace seguimiento de cuántas unidades quedan. Mutuamente excluyente con
  // `sizes` (cada talla sí necesita su propio stock real, ver
  // assertStockModeConsistent en products.controller.js).
  unlimitedStock Boolean @default(false)
  barcode     String?
  images      String[] @default([])
  badge       String?
  // Bloque 52: tallas (pedido explícito) — letras (XS/S/M/L...) o números
  // (calzado), tag libre igual que `tags`. sizeStock mapea cada talla a su
  // stock individual ({"S": 5, "M": 10}); cuando sizes no está vacío, `stock`
  // de arriba se recalcula SIEMPRE como la suma de sizeStock (ver
  // reconcileStock en products.controller.js) para que todo el código
  // existente que ya lee Product.stock (carrito, dashboard, bajo stock,
  // límite de plan, etc.) siga funcionando sin tener que volverse
  // "size-aware" en todos lados — solo el flujo de compra puntual necesita
  // saber de tallas.
  sizes       String[] @default([])
  sizeStock   Json?
  // Bloque 22: hasta 5, opcionales — el vendedor los escribe a mano en
  // VendorProducts.jsx. Siempre en minúscula/trim (products.controller.js),
  // nunca tal cual mayúsculas del vendedor, para que la búsqueda no pierda
  // matches por diferencia de capitalización. Los usa search.controller.js
  // (autocompleteSearch) además de nombre/descripción.
  tags        String[] @default([])
  paymentMethods String[] @default([]) // whatsapp | cod | prepaid
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  // Bloque 16: independiente de isActive/paymentMethods — un producto puede
  // vender en la tienda normal, en el menú QR de mesa, en ambos o en ninguno.
  availableForTableMenu Boolean @default(false)
  // Bloque 157 (pedido explícito — "el vendedor podrá si desea ocultar ese
  // producto de la vista de la tienda y solo será para pedido de la mesa"):
  // independiente de isActive (que sigue controlando si el producto existe
  // "en venta" en absoluto) — con esto en true, un producto que SÍ está
  // activo y disponible para el menú QR deja de aparecer en la tienda
  // pública/catálogo/búsqueda/destacados, pero sigue pidiéndose normal desde
  // la mesa. Sin relación con availableForTableMenu a nivel de dato (nada
  // impide technically marcarlo sin ese otro en true), pero solo tiene
  // sentido real combinado con él — la UI (VendorProducts.jsx) solo lo
  // ofrece cuando availableForTableMenu ya está tildado.
  hiddenFromStore Boolean @default(false)
  // Bloque 157 (pedido explícito — "se podrá configurar si algunos productos
  // son para todas las mesas o para mesas en específico"): false (default) =
  // disponible en TODAS las mesas del vendedor con availableForTableMenu — ni
  // siquiera se consulta restrictedTables en ese caso. true = solo las mesas
  // en restrictedTables pueden pedirlo (ver getTableByToken/createTableOrder,
  // tables.controller.js, que validan esto en ambos sentidos: qué se MUESTRA
  // en el menú de esa mesa y qué se ACEPTA si igual llega en el pedido).
  tableRestricted Boolean @default(false)
  createdAt   DateTime @default(now())
  // Bloque 66: se setea la PRIMERA vez que el producto pasa a isActive:true
  // (ver addProductImages/addProductImageLink en products.controller.js, que
  // ya tenían la lógica `wasEmpty` que activa el producto con su 1ª foto) —
  // es el ancla real de "cuántos días lleva activo" para la etiqueta "Nuevo"
  // automática, en vez de createdAt (que existe desde antes de tener fotos).
  activatedAt DateTime?

  // Bloque 98 (pedido explícito): señales reales para el algoritmo de
  // "Destacados" (ver lib/productRanking.js) — contadores agregados en vez
  // de una tabla de eventos aparte (ProductView/ProductClick), a propósito:
  // lo único que hace falta para rankear es el TOTAL acumulado de cada
  // señal, nunca el historial completo evento por evento, y un contador
  // simple escala mucho mejor en cada carga de Home/catálogo que agregar
  // sobre una tabla de eventos cada vez.
  viewCount        Int @default(0) // se abre la página del producto (interés real)
  clickCount       Int @default(0) // clic en la tarjeta desde cualquier listado
  searchClickCount Int @default(0) // de los de arriba, cuántos vinieron de una búsqueda puntual
  // Int, no BigInt (evita el problema real de que `res.json()`/JSON.stringify
  // no sabe serializar BigInt — hubiera roto TODOS los endpoints que
  // devuelven un Product apenas se agregara esta columna). Con el techo de
  // 30 min por vista (MAX_DWELL_MS, products.controller.js), el límite de
  // Int (~2.147 millones de segundos acumulados) alcanza para más de 71 mil
  // vistas de un mismo producto — más que suficiente para la escala real de
  // este proyecto.
  totalDwellMs Int @default(0) // suma de ms en la página del producto — junto con viewCount da el promedio
  salesCount   Int @default(0) // unidades vendidas CONFIRMADAS (ver confirmOrderSale en orders.controller.js) — nunca solo "pedidas"

  // Bloque 230 (Fase 3 del blindaje del ranking — pedido explícito:
  // "decaimiento temporal en Destacados — 'destacado' pasa a significar
  // 'relevante ahora'"): última vez que hubo un clic real (deduplicado por
  // ip, ver trackProductClick) o una venta confirmada — productRanking.js la
  // usa para bajarle peso a la parte de tráfico/ventas del score cuanto más
  // vieja sea. NO se toca en cada vista/dwell (ver comentario en
  // trackProductClick) — solo señales con algún gate real.
  lastActivityAt DateTime?

  // Bloque 194 (pedido explícito — "notificación por correo... para
  // notificar sobre bajo stock en productos antes que se agoten"): null =
  // todavía no se le avisó al vendedor por este bajón puntual de stock (ver
  // lowStock.job.js). Se marca la primera vez que cae en el rango bajo, así
  // el cron diario no manda el mismo aviso todos los días mientras siga
  // bajo — y se limpia solo (vuelve a null) apenas el stock sube de nuevo
  // por encima del umbral (reponer, o el vendedor sube la cantidad a mano),
  // para que la PRÓXIMA vez que vuelva a bajar sí dispare un aviso nuevo.
  lowStockNotifiedAt DateTime?

  // Bloque 116 (pedido explícito): calificación propia del PRODUCTO (no la de
  // la tienda) para mostrar estrellas + cantidad de reseñas en la tarjeta de
  // cada producto — mismo criterio denormalizado que Vendor.rating (recalculado
  // en reviews.controller.js cada vez que cambia una reseña CON productId),
  // en vez de un aggregate en cada listado: así cualquier endpoint que ya
  // devuelve el Product (Home, catálogo, tienda, búsqueda) lo trae gratis, sin
  // tocar cada uno para sumar una query aparte.
  rating      Decimal @default(0) @db.Decimal(2, 1)
  reviewCount Int     @default(0)

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  options    ProductOption[]
  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]
  requests   ProductRequest[]
  offers     Offer[]
  priceTiers ProductPriceTier[]
  reports    Report[]
  // Bloque 157: solo tiene efecto real cuando tableRestricted:true (ver
  // arriba) — many-to-many implícita, cada mesa puede tener varios productos
  // restringidos a ella y cada producto puede restringirse a varias mesas.
  restrictedTables Table[] @relation("ProductTableRestriction")
  // Bloque 198: ventas manuales — ver VendorStaffAllocation/VendorStaffSale.
  staffAllocations VendorStaffAllocation[]
  staffSales       VendorStaffSale[]
  // Bloque 228 (Fase 1, "blindar el ranking" — pedido explícito): ver
  // ProductClickEvent más abajo. Vive aparte de clickCount/searchClickCount
  // (arriba) a propósito — es el único registro evento-por-evento de este
  // modelo, pero su función es exclusivamente deduplicar ANTES de sumarle a
  // esos contadores, nunca se lee para rankear (el ranking sigue leyendo
  // solo los contadores agregados, tal como ya explica el comentario del
  // Bloque 98 más arriba).
  clickEvents ProductClickEvent[]
  // Bloque 229 (Fase 2): anomalías de ranking detectadas contra este
  // producto — ver RankingAnomaly más abajo.
  rankingAnomalies RankingAnomaly[]

  @@unique([vendorId, slug])
}

// Bloque 228 (pedido explícito — Fase 1 del blindaje del ranking: "sin esto,
// el 30% de clics es falsificable", los pesos de clickCount+searchClickCount
// en productRanking.js suman justo 0.30): antes trackProductClick sumaba 1
// SIEMPRE, sin ningún control — cualquiera (o un script) podía spamear el
// endpoint público y mandar el score del producto para arriba a mano. Esta
// tabla guarda solo lo mínimo para poder preguntar "¿esta IP ya clickeó este
// producto hace poco?" antes de sumar — se limpia sola (ver
// jobs/clickAnomaly.job.js, Fase 2) en vez de crecer para siempre.
model ProductClickEvent {
  id        String   @id @default(cuid())
  productId String
  // Nunca la IP en texto plano — mismo criterio que refreshTokenHash en
  // Session (hashToken, sha256): no hace falta poder "leer" la IP de vuelta,
  // solo comparar igualdad para el dedup, así que un hash rápido e
  // indexable alcanza y de paso no guarda un dato personal identificable
  // en texto claro.
  ipHash    String
  source    String? // "search" | "home" | "catalog" | "store" — igual que trackClickSchema
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Índice compuesto: es exactamente la consulta que hace el dedup
  // ("¿existe un evento de este producto+IP después de tal hora?") en cada
  // clic público — sin este índice, esa consulta escanearía la tabla entera
  // a medida que crece.
  @@index([productId, ipHash, createdAt])
  // Aparte, para que la limpieza periódica (borrar filas viejas) y el cron
  // de picos de clics (Fase 2) puedan barrer por fecha sin escanear todo.
  @@index([createdAt])
}

// Bloque 229 (pedido explícito — Fase 2, "visibilidad para el admin...
// reutiliza las señales de la Fase 1"): cola de cosas raras que detectan
// los crons de reseñas/clics — SOLO levanta bandera, nunca decide ni actúa
// sola (mismo espíritu que la máquina de estados de Report, pero Report en
// sí no sirve para esto: exige reporterId + screenshotUrl reales, pensado
// para un reporte humano, no para algo que detecta un cron sin ningún
// usuario ni captura de por medio). Un admin la revisa y decide —
// DISMISSED (falsa alarma) o ACTIONED (ya hizo algo al respecto, a mano,
// en Tiendas/Productos/Comentarios — esta tabla nunca ejecuta ninguna
// consecuencia por sí sola).
enum RankingAnomalyKind {
  REVIEW_BURST
  CLICK_SPIKE
}

enum RankingAnomalyStatus {
  PENDING
  DISMISSED
  ACTIONED
}

model RankingAnomaly {
  id         String               @id @default(cuid())
  kind       RankingAnomalyKind
  status     RankingAnomalyStatus @default(PENDING)
  productId  String?
  vendorId   String?
  // Texto legible armado por el propio cron (mismo criterio que
  // buildSignalsText en vendorDailyTips.service.js) — nunca un número
  // suelto sin contexto, el admin tiene que poder entender QUÉ vio el cron
  // sin tener que ir a leer el código.
  details    String               @db.Text
  detectedAt DateTime             @default(now())

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?   @db.Text

  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor     Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("RankingAnomalyReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([kind])
  @@index([productId])
  @@index([vendorId])
}

// Bloque 55: precios por cantidad (mayoreo) — 100% opcional, el vendedor
// decide por producto si lo activa. Cada fila dice "a partir de esta
// cantidad, el precio POR UNIDAD baja a este" — nunca reemplaza Product.price
// (que sigue siendo el precio de 1 unidad), solo lo abarata a partir de un
// umbral. Se resuelve el tier aplicable según la cantidad tanto al mostrarle
// el precio al cliente como al confirmar un pedido de verdad (ver
// resolveUnitPrice en lib/pricing.js) — nunca se confía en un precio que
// mande el cliente.
model ProductPriceTier {
  id        String  @id @default(cuid())
  productId String
  // Cantidad mínima para que aplique este precio — siempre >= 2 (1 unidad ya
  // la cubre Product.price, no hace falta una fila para eso).
  minQty    Int
  price     Decimal @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQty])
  @@index([productId, minQty])
}

// Variantes de producto / ítem de menú (ej. "Guarnición": Congrí, Arroz blanco, Puré (+80))
model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  values    String[] @default([])

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Usuarios y tiendas
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  fullName     String?
  phone        String?
  address      String?
  provinceId   String?
  // Bloque 113 (pedido explícito): dónde vive/opera de verdad el cliente,
  // elegido en el registro contra el catálogo REAL de países del admin
  // ("Países y provincias") — distinto de `country` de abajo, que es solo
  // el código ISO del teléfono (puede diferir: alguien puede tener número
  // +1 pero vivir en Cuba). `registrationCountryOther` guarda el nombre
  // tal cual lo escribió si su país real no estaba en la lista (nunca se
  // fuerza a elegir uno que no es el suyo).
  registrationCountryId    String?
  registrationCountryOther String?
  municipalityId           String?
  // Bloque 114 (pedido explícito): fuera de Cuba ya no se elige una
  // provincia/estado del catálogo (`Province` con type=STATE) — se escribe
  // a mano, junto con `address` (arriba, ya existía sin usar) como la
  // dirección. Solo tiene sentido cuando `registrationCountryId` apunta a
  // un país real que NO es Cuba (con Cuba, `provinceId`/`municipalityId`
  // de arriba mandan; con "otro país" ninguno de los dos aplica).
  stateOther   String?
  country      String? // ISO 3166-1 alpha-2 (ej. "CU"), usado para el código de marcado del teléfono
  isSuspended  Boolean  @default(false)
  // Bloque 12: soft-delete — nunca se borra la fila (los pedidos históricos
  // necesitan customerId intacto). isSuspended:true en simultáneo es lo que
  // realmente bloquea el login (ver auth.controller.js); deletedAt es solo
  // el flag de auditoría que distingue "eliminado" de "suspendido a mano".
  deletedAt    DateTime?
  // Bloque 211 (pedido explícito — auto-eliminación de cuenta con 30 días de
  // gracia, clientes/vendedores/personal): distinto de isSuspended/deletedAt
  // de arriba a propósito — esos son del borrado INSTANTÁNEO que dispara un
  // admin. Acá, mientras dure el período de gracia, el login sigue andando
  // normal (nunca se gatea en auth.controller.js); lo único que cambia es
  // que el panel muestra el aviso de baja en vez del panel real (mismo
  // criterio ya usado para Vendor.isBlocked, ver VendorLayout.jsx). Pasados
  // 30 días sin reactivar, el cron (accountDeletion.job.js) recién ahí pone
  // deletedAt de verdad, vía el mismo finalizeUserDeletion() que usa el
  // borrado manual de un admin.
  deletionRequestedAt   DateTime?
  // Marca de "ya se mandó el aviso de 7 días antes" — evita mandarlo 2 veces
  // si el cron se cae un día y corre tarde (mismo criterio que
  // vendorLifecycle.job.js/lowStock.job.js).
  deletionReminderSentAt DateTime?
  createdAt    DateTime @default(now())
  // Bloque 62: se actualiza en cada login exitoso (auth.controller.js) —
  // clientes, vendedores y admin por igual, una sola tabla. Para un
  // vendedor, "acceder a su panel" = loguearse con esta cuenta; es lo que
  // usa el cron de inactividad (vendorLifecycle.job.js) para el
  // recordatorio de 7 días y la suspensión automática a los 90. null =
  // nunca inició sesión desde que existe la cuenta (no se asume actividad
  // retroactiva al desplegar esta migración).
  lastLoginAt  DateTime?

  // Reset de contraseña por código (nunca en texto plano, expira ~15 min).
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?

  // Bloque 60: código de verificación en dos pasos del LOGIN — campos
  // propios, separados de resetCodeHash/resetCodeExpiresAt (un reset de
  // contraseña en curso no debe pisar un código de 2FA en curso, ni
  // viceversa). Antes (Bloque 47) esto era opt-in vía `twoFactorEnabled`
  // (columna eliminada en esta misma migración) — ahora se pide siempre que
  // no haya un TrustedDevice vigente para esta cuenta (ver auth.controller.js).
  twoFactorCodeHash      String?
  twoFactorCodeExpiresAt DateTime?

  // Bloque 71 (pedido explícito): cambiar de correo deja de ser directo —
  // primero hay que probar acceso al correo VIEJO (el que ya está en la
  // cuenta), con un código propio (letras+números, nunca reutiliza
  // resetCodeHash/twoFactorCodeHash) mandado a esa dirección. pendingEmail
  // guarda el correo pedido hasta que el código se confirma — recién ahí se
  // escribe de verdad en `email`.
  pendingEmail             String?
  emailChangeCodeHash      String?
  emailChangeCodeExpiresAt DateTime?

  // Bloque 183 (pedido explícito — "el usuario deberá ingresar el correo...
  // el sistema detecta que ese usuario no tiene una contraseña válida
  // aún... se le enviará un código... podrá ingresar su nueva contraseña"):
  // se crea con passwordHash puesto a un valor aleatorio inservible (nunca
  // null — la columna sigue siendo NOT NULL) y este flag en true. login()
  // lo chequea ANTES de comparar la contraseña — si está en true, ni
  // siquiera se intenta el bcrypt.compare(), se responde
  // `requiresPasswordSetup` directo (mismo criterio que requiresTwoFactor).
  // Reusa el flujo de "olvidé mi contraseña" ya existente (resetCodeHash/
  // forgotPassword/resetPassword) — es literalmente el mismo problema
  // ("no hay una contraseña utilizable, hay que probar el correo y poner
  // una nueva"), así que resetPassword también apaga este flag al usarse.
  mustSetPassword Boolean @default(false)

  province  Province?  @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  municipality         Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  registrationCountry  Country?      @relation(fields: [registrationCountryId], references: [id], onDelete: SetNull)
  vendor    Vendor?
  addresses Address[]
  orders    Order[]
  favorites Favorite[]
  reviews   Review[]
  // Bloque 69: reportes de reseñas que este usuario hizo/resolvió — nombradas
  // aparte de `reviews` (esa es "las reseñas que escribió", esto es "las
  // que reportó" o "las que resolvió como admin").
  reportedReviews       Review[] @relation("ReviewReportedBy")
  reportResolvedReviews Review[] @relation("ReviewReportResolvedBy")
  reviewedVerifications VerificationRequest[] @relation("ReviewedBy")
  paymentConfirmedVerifications VerificationRequest[] @relation("PaymentConfirmedBy")
  marketplaceChatMessages MarketplaceChatMessage[]
  suggestions Suggestion[]
  vendorEngagements VendorEngagement[]
  sentVendorMessages VendorMessage[]
  productRequests ProductRequest[]
  chatTrainingExamples ChatTrainingExample[]
  cartSnapshot CartSnapshot?
  sessions Session[]
  trustedDevices TrustedDevice[]
  vendorStatusChangesMade VendorStatusLog[]
  winbackEmailsReceived   WinbackEmailLog[]
  verificationStatusChangesMade VerificationStatusLog[]
  activityLogs ActivityLog[]
  verificationArchivesReviewed VerificationArchive[] @relation("VerificationArchiveReviewedBy")
  subscriptionPaymentsConfirmed SubscriptionPayment[] @relation("SubscriptionPaymentConfirmedBy")
  vendorChangeRequestsReviewed  VendorChangeRequest[] @relation("VendorChangeRequestReviewedBy")
  // Anuncios de venta rápida propios (clientes sin tienda) — ver
  // CustomerListing más abajo.
  customerListings CustomerListing[]
  // Feature B: reportes de fraude que este usuario hizo (nombrado "made"
  // para no chocar con reportedReviews de arriba, que es otra cosa) y los
  // que resolvió como admin — mismo criterio que reportResolvedReviews.
  reportsMade     Report[] @relation("ReportsMade")
  reportsResolved Report[] @relation("ReportsResolvedBy")
  // Bloque 183: este User ES un usuario de sistema de un negocio (rol
  // VENDOR_STAFF) — null para clientes/vendedores/admin normales.
  vendorStaffProfile VendorStaff?
  // Bloque 183: usuarios de sistema que ESTE usuario (vendedor/admin) dio
  // de alta — puramente informativo/auditoría, nunca decide permisos.
  vendorStaffCreated VendorStaff[] @relation("VendorStaffCreatedBy")
  // Bloque 229 (Fase 2): anomalías de ranking que este admin revisó — ver
  // RankingAnomaly más abajo.
  rankingAnomaliesReviewed RankingAnomaly[] @relation("RankingAnomalyReviewedBy")
}

// Bloque 60: reemplaza el refresh token JWT sin estado por uno opaco
// respaldado por esta tabla — es lo que hace posible revocar una sesión de
// verdad (logout, "cerrar en todos los dispositivos", expiración por
// inactividad) en vez de solo borrar el token del lado del cliente y
// dejarlo igual de válido en el servidor hasta que expire solo. `browserId`
// (no la sesión en sí) es lo que identifica "este navegador" — un login
// nuevo revoca cualquier Session previa de ese mismo (userId, browserId),
// garantizando una sola sesión activa por navegador.
model Session {
  id               String    @id @default(cuid())
  userId           String
  browserId        String
  refreshTokenHash String    @unique
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, browserId])
}

// Bloque 60: "recordar este dispositivo" — token opaco propio (nunca el
// mismo que el refresh token de Session), guardado en localStorage y NUNCA
// borrado por un logout normal (justamente lo que lo distingue de una
// sesión: sobrevive cerrar sesión, solo se borra si expira o si el dueño de
// la cuenta cierra sesión en todos los dispositivos). Ventana rodante de 30
// días — se extiende cada vez que se usa para saltar el código de login.
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Bloque 59 (pedido explícito): verificación de correo obligatoria ANTES de
// crear la cuenta real (cliente o vendedor — el registro de vendedor es el
// mismo POST /auth/register + un POST /vendors después, así que gatearlo acá
// alcanza para los dos). A diferencia de resetCodeHash/twoFactorCodeHash (que
// viven como columnas de un User que YA existe), acá todavía no hay ningún
// User que crear — se guardan los datos del formulario + el código en esta
// tabla aparte, y recién se crea el User real cuando el código se verifica
// (ver verifyRegistration en auth.controller.js). Si el cliente nunca
// verifica, no queda ningún User "fantasma" a medio crear — solo esta fila,
// que un reintento de registro con el mismo correo simplemente sobrescribe
// (upsert por email).
model PendingRegistration {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  phone         String
  country       String
  // Bloque 113 (pedido explícito): país/provincia/municipio elegidos en el
  // registro (ver User.registrationCountryId/provinceId/municipalityId) —
  // strings sueltos (no FK, mismo criterio que `country` de arriba) porque
  // esta fila es efímera: se borra apenas se verifica el código y se crea
  // el User real, donde sí quedan como relaciones reales.
  registrationCountryId    String?
  registrationCountryOther String?
  provinceId               String?
  municipalityId           String?
  // Bloque 114: staging de lo mismo que User.stateOther/address — ver ahí.
  stateOther    String?
  address       String?
  codeHash      String
  codeExpiresAt DateTime
  createdAt     DateTime @default(now())
}

model Vendor {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  // Persona física responsable del negocio (KYC/contacto legal) — privado,
  // nunca se expone en los endpoints públicos de tienda (ver vendors.controller.js).
  ownerName   String?
  slug        String   @unique
  description String?
  whatsapp    String
  email       String?
  // Bloque 29: datos de facturación — distinto del idNumber de
  // VerificationRequest (ese es KYC de la persona física para el badge
  // verificado, gated por isVerified; este es de la EMPRESA/responsable,
  // necesario para cualquier vendedor que quiera emitir factura/garantía,
  // esté o no verificado). Nullable a nivel de columna (no forzar backfill
  // de tiendas ya sembradas) pero obligatorio a nivel de formulario en
  // VendorSettings.jsx/VendorOnboarding.jsx, y validado de nuevo server-side
  // como gate duro justo antes de generar un PDF (ver invoices.controller.js)
  // — ese es el único punto donde su ausencia realmente rompe algo.
  ownerIdNumber  String?
  companyAddress String?
  // Bloque 66 (pedido explícito): datos legales de verificación — PRIVADOS,
  // nunca expuestos en getVendorBySlug ni ningún endpoint público (mismo
  // criterio que ownerIdNumber/companyAddress arriba). companyTaxId es el ID
  // fiscal de la empresa; alternativa a ownerIdNumber (el gate de envío de la
  // verificación exige al menos uno de los dos, no ambos). registrationCountryId/
  // legalProvinceId/legalMunicipalityId son el país/provincia/municipio de
  // registro LEGAL del negocio — distinto de VendorLocation (esa es zona de
  // servicio/venta, esto es domicilio legal).
  companyTaxId String?
  registrationCountryId String?
  legalProvinceId       String?
  legalMunicipalityId   String?
  logoUrl     String?
  color       String?
  categoryId  String?
  // Bloque 18: rubro/tipo de negocio elegido en el registro (obligatorio a
  // nivel de formulario/zod, no a nivel de columna — nullable acá para no
  // forzar un backfill de las tiendas ya sembradas en bloques anteriores).
  businessCategoryId String?
  isRestaurant Boolean @default(false)
  tableCount  Int?
  // Bloque 208 (pedido explícito — "los negocios podrán seleccionar si sus
  // menús digitales son ocultos, solo para pedidos escaneando la mesa, o
  // serán públicos para cualquier persona con acceso a su página web"):
  // default true preserva el comportamiento de siempre (el menú ya se
  // mostraba en Store.jsx sin este toggle) — recién ahora el vendedor puede
  // decidir ocultarlo. Solo afecta la tienda pública (getVendorBySlug);
  // getTableByToken (QR real de la mesa) nunca lo consulta, siempre muestra
  // el menú completo sin importar este valor.
  menuPublic Boolean @default(true)
  planType    PlanType @default(REGULAR)
  orderDestination OrderDestination @default(WHATSAPP)
  // Bloque 64: reemplaza el booleano `isVerified` (guardado aparte,
  // desincronizable — ver el enum arriba) — este es el ÚNICO campo que
  // cualquier parte del sitio debe leer para saber si el badge/IA/destacado
  // corresponden. Nunca se escribe directo — siempre vía
  // transitionVendorVerification() (services/vendorVerification.service.js).
  verificationStatus   VendorVerificationStatus @default(NOT_STARTED)
  // Cobro recurrente real (Bloque 64) — null hasta la primera vez que la
  // tienda complete un checkout de suscripción. stripeCustomerId sobrevive a
  // una suscripción cancelada (permite crear una nueva sin pedir los datos de
  // pago de nuevo); stripeSubscriptionId es la suscripción VIGENTE puntual,
  // se reemplaza si se crea una nueva tras SUSPENDED.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // Próximo vencimiento del cobro — para Stripe es informativo (se actualiza
  // desde el propio invoice del webhook, Stripe vence solo); para CUP es lo
  // que el cron de verificationPayment.job.js usa de verdad para recordar (7
  // días antes) y vencer (PAYMENT_FAILED) si nadie confirma un pago nuevo.
  nextPaymentDueDate   DateTime?
  isBlocked   Boolean  @default(false)
  // Bloque 75 (pedido explícito, bug real reportado en vivo): antes de esto
  // un vendedor bloqueado a mano por un admin no tenía forma de saber por
  // qué — su panel seguía cargando todo con normalidad, sin ningún aviso.
  // Se guarda el motivo que el admin escribe al bloquear (obligatorio, ver
  // AdminVendors.jsx) y se limpia solo al desbloquear — VendorLayout.jsx lo
  // muestra en una pantalla de bloqueo real, igual que ya hacía
  // suspensionReason para el caso de suspensión automática por inactividad.
  blockReason String?
  // Bloque 76: para poder ordenar/mostrar "bloqueada el" en "Tiendas
  // suspendidas" (AdminSuspendedVendors.jsx) igual que ya hace suspendedAt
  // para el caso automático — se setea/limpia junto con blockReason.
  blockedAt   DateTime?
  // Bloque 77 (pedido explícito): tienda privada — sigue 100% funcional por
  // su link directo (/tienda/:slug, productos, checkout, reseñas, etc., sin
  // ningún cambio) pero desaparece de TODO punto de descubrimiento público
  // (catálogo de tiendas, Home, buscador, autocompletado, categorías,
  // recomendaciones del asistente de IA) — nunca de las acciones que ya
  // tenía en curso (pedidos existentes, mensajes, etc.). El vendedor comparte
  // su propio link/QR desde VendorSettings.jsx; nadie más la encuentra sola.
  isPrivate   Boolean  @default(false)
  // Bloque 12: soft-delete de tienda — al eliminar se fuerza isBlocked:true
  // también (así los ~8 puntos del código que ya filtran por isBlocked:false
  // ocultan la tienda sin tocar cada uno) y se guarda deletedAt como marca
  // de auditoría/UI ("Eliminada" en vez de "Bloqueada", sin botón de revertir).
  deletedAt   DateTime?
  // Bloque 211 (pedido explícito — el vendedor pide eliminar SU cuenta desde
  // VendorProfile.jsx): espejo de User.deletionRequestedAt, seteado en la
  // misma transacción — reusa isBlocked:true (con un blockReason fijo) para
  // ocultar la tienda ya mismo con cero filtros nuevos (listVendors/
  // getVendorBySlug ya excluyen isBlocked:true), y le sirve a VendorLayout.jsx
  // para mostrarle el aviso de baja también al personal que entre mientras
  // la tienda del dueño está en cuenta regresiva. `null` = no hay ninguna
  // baja de cuenta en curso.
  deletionRequestedAt DateTime?
  // Bloque 62: tercer estado, distinto de isBlocked (el admin bloquea a
  // mano, reversible en cualquier momento desde AdminVendors.jsx) y de
  // deletedAt (soft-delete, sin vuelta atrás) — SUSPENDED lo pone el cron de
  // inactividad (vendorLifecycle.job.js) solo, nunca un admin a mano; se
  // reactiva desde AdminSuspendedVendors.jsx con un motivo obligatorio.
  // Todo punto que hoy filtra por isBlocked:false para decidir qué tienda es
  // pública también filtra status:ACTIVE (ver vendors.controller.js y el
  // resto de los controllers listados en el pedido de este bloque).
  status                VendorStatus @default(ACTIVE)
  suspendedAt           DateTime?
  suspensionReason      String?
  reactivatedAt         DateTime?
  reactivationReason    String?
  // Para no reenviar el recordatorio de 7 días todos los días — se re-manda
  // cada 7 días de inactividad continua (día 7, 14, 21... hasta reactivar o
  // llegar a los 90 días de suspensión automática).
  lastInactivityEmailAt DateTime?
  rating      Decimal  @default(0) @db.Decimal(2, 1)
  salesCount  Int      @default(0)
  timezone    String   @default("America/Havana")
  // Bloque 21: aiDocument pasa a ser el nombre generado por el servidor
  // (igual que kycUpload.js — nunca el original, evita path traversal /
  // adivinar rutas) que el chatbot lee del disco; aiDocumentName es el
  // nombre real del archivo, solo para mostrarle al vendedor cuál subió.
  aiDocument     String?
  aiDocumentName String?
  // Bloque 14: puramente informativo — qué métodos de pago acepta la tienda
  // (Zelle, Visa, USDT, etc. + entradas de texto libre para "otro"). Nunca
  // se valida ni se procesa nada acá, es solo lo que se muestra en
  // Store.jsx para que cliente y vendedor coordinen directo entre ellos.
  acceptedPaymentMethods String[] @default([])
  // Bloque 65 (pedido explícito): moneda operativa ÚNICA de la tienda —
  // la moneda real en la que están expresados TODOS los precios de la
  // tienda, elegida en el registro, editable después. Todo producto de
  // esta tienda usa esta moneda —
  // createProduct/updateProduct la fuerzan server-side, nunca se acepta un
  // valor de currency distinto mandado por el cliente (ver products.controller.js).
  currency ProductCurrency @default(CUP)
  // Sección "Garantías" (VendorSettings.jsx): condiciones propias de cada
  // negocio que se imprimen en el certificado de garantía (ver
  // generateWarrantyPdf en lib/pdf.js). Ambos campos son obligatorios para
  // poder GENERAR o ENVIAR una garantía (gate en invoices.controller.js,
  // separado del gate de facturación que ya exige ownerName/ownerIdNumber/
  // companyAddress) — nullable a nivel de columna para no forzar backfill de
  // tiendas ya sembradas, igual criterio que companyAddress arriba.
  warrantyTerms       String? @db.Text
  warrantyDefaultDays Int?
  // Bloque 66 (pedido explícito): cancelar la suscripción NO revoca el
  // acceso de inmediato — solo marca la intención; el vendedor sigue
  // VERIFIED hasta nextPaymentDueDate. El cron de verificationPayment.job.js
  // (o el webhook customer.subscription.deleted de Stripe, que dispara solo
  // al llegar cancel_at_period_end) recién ahí transiciona a NOT_STARTED.
  cancelAtPeriodEnd Boolean @default(false)
  // Bloque 198 (pedido explícito — "se podrán enviar recordatorios a los
  // usuarios en caso de que el vendedor asigne un día que sea el día para
  // cuadrar la caja"): null = recordatorio desactivado. DAILY no usa ningún
  // día (se dispara todos los días); WEEKLY usa cashCloseDayOfWeek (1=lunes,
  // ISO); MONTHLY usa cashCloseDayOfMonth. cashCloseReminderSentAt es la
  // marca de "ya se mandó hoy" — mismo criterio anti-duplicado que
  // lastInactivityEmailAt, más abajo.
  cashCloseFrequency      CashCloseFrequency?
  cashCloseDayOfWeek      Int?
  cashCloseDayOfMonth     Int?
  cashCloseReminderSentAt DateTime?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation("VendorCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  businessCategory BusinessCategory? @relation(fields: [businessCategoryId], references: [id], onDelete: SetNull)
  registrationCountry Country?      @relation(fields: [registrationCountryId], references: [id], onDelete: SetNull)
  legalProvince       Province?     @relation(fields: [legalProvinceId], references: [id], onDelete: SetNull)
  legalMunicipality   Municipality? @relation(fields: [legalMunicipalityId], references: [id], onDelete: SetNull)

  locations     VendorLocation[]
  schedules     VendorSchedule[]
  products      Product[]
  tables        Table[]
  orders        Order[]
  reviews       Review[]
  verification  VerificationRequest?
  emailLogs     EmailLog[]
  engagements   VendorEngagement[]
  messages      VendorMessage[]
  notifications VendorNotification[]
  deliveryCountries VendorDeliveryCountry[]
  favorites     Favorite[]
  chatMessages  ChatMessage[]
  productRequests ProductRequest[]
  offers        Offer[]
  discountCodes DiscountCode[]
  storeOffers   StoreOffer[]
  sharedCarts   SharedCart[]
  statusLogs       VendorStatusLog[]
  winbackEmailLogs WinbackEmailLog[]
  verificationStatusLogs VerificationStatusLog[]
  activityLogs     ActivityLog[]
  verificationArchives VerificationArchive[]
  reports          Report[]
  // Bloque 153 (pedido explícito): pagos de RENOVACIÓN de la suscripción
  // (meses extra mientras la tienda YA está VERIFIED) — historial completo,
  // separado del ciclo inicial de verificación (VerificationRequest/
  // VerificationArchive, Bloques 150-152), que sigue intacto tal cual.
  subscriptionPayments SubscriptionPayment[]
  // Bloque 153 (pedido explícito — "todos los datos de la tienda no se
  // pueden modificar después de estar verificadas sin aprobación del
  // admin"): solicitudes de cambio a datos de identidad de una tienda ya
  // verificada.
  changeRequests VendorChangeRequest[]
  // Bloque 183: usuarios de sistema con acceso restringido a este negocio.
  staff VendorStaff[]
  // Bloque 194 (pedido explícito — "la IA vaya reconociendo el modo de uso
  // del negocio y le recomiende consejos... consejos diarios"): un registro
  // por día calendario, ver VendorDailyTip más abajo.
  dailyTips VendorDailyTip[]
  // Bloque 198: ventas manuales de los usuarios de sistema — ver
  // VendorStaffSale más arriba.
  staffSales VendorStaffSale[]
  // Bloque 229 (Fase 2, pedido explícito — "visibilidad para el admin...
  // reutiliza las señales de la Fase 1"): anomalías detectadas por los
  // crons de reseñas/clics contra esta tienda, ver RankingAnomaly más abajo.
  rankingAnomalies RankingAnomaly[]
}

// Bloque 194 (pedido explícito — "agregar una sección dentro del dashboard
// para que, basado en cómo funciona el negocio, la IA vaya reconociendo el
// modo de uso... y le recomiende consejos... ofertas en productos vendidos,
// movimiento de inventarios para que los productos que no salen puedan
// salir... consejos diarios"): se genera UNA vez por día calendario (nunca
// en cada carga del Dashboard — sería IA de más sin necesidad real, ver
// generateVendorDailyTips en vendors.controller.js) a partir de señales
// reales del propio negocio (ventas, clics, stock quieto). `tips` es un
// array de objetos { title, description } — Json y no filas propias porque
// siempre se leen/regeneran juntos, nunca uno por uno.
model VendorDailyTip {
  id               String   @id @default(cuid())
  vendorId         String
  tips             Json
  generatedForDate DateTime @db.Date
  createdAt        DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, generatedForDate])
}

// Bloque 194 (pedido explícito — "ofertas autodirigidas... para clientes o
// para vendedores, podrán ser enviadas por email o mostrarse en el panel o
// en la cuenta cuando el cliente o vendedor se logeen como forma de popup,
// o ambas... lanzar ofertas a vendedores específicos como los registrados
// en el plan Business o los no registrados, y a uno en específico"):
// distinta de Offer (carrusel público del Home) y de Campaign (correo
// masivo sin estado de lectura) — esta SÍ se muestra como popup personal la
// próxima vez que ese usuario entra a su cuenta, con estado de visto/
// descartado por persona (ver TargetedOfferView más abajo), además de
// poder mandarse por correo con la misma infraestructura que Campaign.
//
// `audience` es texto libre validado en el controller (mismo criterio que
// Campaign.segment, arriba) — valores válidos: "all_customers" |
// "all_vendors" | "regular_vendors" | "business_vendors" |
// "unverified_vendors" | "specific_vendor" | "specific_customer".
// `targetVendorId`/`targetUserId` SIN relación de Prisma a propósito
// (mismo criterio que Campaign.provinceId — un id suelto, no una FK real)
// — evita tocar los modelos Vendor/User solo por esto, y de cualquier
// forma se valida su existencia a mano en el controller antes de guardar.
model TargetedOffer {
  id             String                @id @default(cuid())
  title          String
  message        String                @db.Text
  imageUrl       String?
  ctaLabel       String?
  ctaUrl         String?
  audience       String
  targetVendorId String?
  targetUserId   String?
  delivery       TargetedOfferDelivery @default(BOTH)
  status         TargetedOfferStatus   @default(ACTIVE)
  emailSentCount Int                   @default(0)
  emailSentAt    DateTime?
  // null = el popup sigue mostrándose hasta que el admin la archive a mano.
  expiresAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  views TargetedOfferView[]

  @@index([status, audience])
}

enum TargetedOfferDelivery {
  EMAIL
  POPUP
  BOTH
}

enum TargetedOfferStatus {
  ACTIVE
  ARCHIVED
}

// Bloque 194: un registro por (oferta, usuario) — `dismissedAt` null = el
// popup todavía le corresponde mostrarse a ESE usuario en su próximo login;
// seteado = ya lo cerró, nunca más se lo vuelve a mostrar aunque la oferta
// siga ACTIVE. Sin relación a User a propósito (mismo criterio que arriba).
model TargetedOfferView {
  id              String    @id @default(cuid())
  targetedOfferId String
  userId          String
  dismissedAt     DateTime?
  createdAt       DateTime  @default(now())

  targetedOffer TargetedOffer @relation(fields: [targetedOfferId], references: [id], onDelete: Cascade)

  @@unique([targetedOfferId, userId])
  @@index([userId])
}

// Bloque 183 (pedido explícito — "quiero que el administrador, vendedor,
// dueño del negocio... pueda crear usuarios con roles dentro de su
// negocio... solo le va a salir la sección de pedidos o la que él
// designe... podrá gestionar cada usuario y qué es lo que está haciendo en
// la cuenta"): un usuario de sistema del panel de vendedor — User real
// (role VENDOR_STAFF) + este perfil aparte con lo que es específico de
// "acceso restringido a un negocio" (nunca mezclado con Vendor, que es el
// DUEÑO). `allowedSections` son las mismas claves que usa el NAV del panel
// (VendorLayout.jsx) y requireVendorAccess() del lado del backend — un solo
// array de verdad para las 2 puntas, nunca solo cosmético en el frontend.
model VendorStaff {
  id              String   @id @default(cuid())
  userId          String   @unique
  vendorId        String
  allowedSections String[] @default([])
  // Bloque 185 (pedido explícito — "también debe seleccionar qué permisos
  // tendrá el usuario en esa sección, si solo lectura o modificar, si leer
  // o escribir"): mapa `{ [sectionKey]: "view" | "manage" }` — solo tiene
  // sentido para las claves que además están en `allowedSections` (sin
  // acceso a la sección, el nivel ni se consulta). Una sección presente en
  // `allowedSections` pero AUSENTE acá (o creada antes de este bloque) se
  // trata como "manage" — ver `sectionLevel()` en requireVendorAccess.js —
  // así ningún usuario ya creado pierde funcionalidad de golpe con esta
  // migración. Json y no una tabla aparte: son pocas claves, siempre se leen
  // todas juntas, y así se puede ampliar más adelante a más de 2 niveles sin
  // otra migración de columnas.
  sectionPermissions Json   @default("{}")
  // Foto tomada por el vendedor/admin al darlo de alta (pedido explícito:
  // "esa foto saldrá en el perfil del usuario") — sube por el mismo
  // middleware de archivos que ya usa el branding de tienda.
  photoUrl        String?
  // Bloque 198 (pedido explícito — "ventas manuales"): mismo criterio que
  // photoUrl — un dato propio de ESTE usuario de sistema, nunca del User
  // compartido. Hace falta para que la sugerencia de "este compañero
  // todavía tiene stock" sea realmente accionable (poder llamarlo/
  // escribirle), no solo un nombre.
  phone           String?
  // Bloque 200: null = sin tipo específico — ver el comentario largo en el
  // enum VendorStaffType, más arriba en este archivo.
  staffType       VendorStaffType?
  // Bloque 205 (pedido explícito — "especificar si el usuario recibe las
  // notificaciones de nuevos pedidos... los meseros la llevarán marcada
  // predeterminadamente, pero los agentes de ventas no, salvo que el dueño
  // lo habilite"): controla el gate de NewOrderPopup/StaleOrderAlert
  // (VendorLayout.jsx) para este usuario puntual — el default de la
  // COLUMNA es `false` a propósito (el "true si es mesero" es una decisión
  // de UX al crear, no algo que la base de datos deba inventar sola); ver
  // el default por staffType en CreateStaffModal, VendorUsers.jsx.
  receivesOrderNotifications Boolean @default(false)
  createdByUserId String
  // Desactivar en vez de borrar — el historial de ActivityLog/Session de
  // este usuario tiene que sobrevivir siempre (auditoría real, no se pierde
  // nunca), aunque el vendedor le saque el acceso. login() lo chequea igual
  // que isSuspended en User.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdBy User   @relation("VendorStaffCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  allocations VendorStaffAllocation[]
  sales       VendorStaffSale[]
  cashCloses  VendorStaffCashClose[]

  @@index([vendorId])
}

// Bloque 198 (pedido explícito — "cada usuario podrá controlar su stock por
// usuario... los usuarios van a poder buscar entre los productos agregados
// en la base de datos de la tienda, agregar un producto a su sección de
// producto de usuario... la cantidad de inventario que no se agregue se
// queda disponible y otro usuario puede agregarlo"): una fila por par
// (usuario de sistema, producto) — `remainingQty` es SIEMPRE una porción
// del Product.stock real, nunca un stock aparte. El "pool sin reclamar" de
// un producto = Product.stock − SUMA(remainingQty de todas sus filas), se
// calcula al vuelo (nunca se guarda), ver claimAllocation en el controller.
model VendorStaffAllocation {
  id            String   @id @default(cuid())
  vendorStaffId String
  productId     String
  // Total histórico reclamado por este usuario (nunca baja) — remainingQty
  // sí baja con cada venta/liberación. La diferencia entre ambos es cuánto
  // ya vendió o devolvió, sin necesitar sumar VendorStaffSale para saberlo.
  allocatedQty  Int      @default(0)
  remainingQty  Int      @default(0)
  // Bloque 199 (pedido explícito — el dueño reasignaba stock y el usuario
  // destino tenía que "aceptar el lote" antes de poder venderlo, simulando
  // "fue a buscar el lote físico y lo confirmó") — Bloque 206 (pedido
  // explícito — "elimina que los usuarios deban aceptar lotes... pasa al
  // inventario de ese usuario sin tomar acción"): revertido, reassignAllocation
  // ya escribe directo en allocatedQty/remainingQty. Columna sin uso desde
  // entonces (se mantiene solo para no romper filas viejas) — nunca debería
  // quedar en > 0 de acá en adelante.
  pendingQty    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendorStaff VendorStaff @relation(fields: [vendorStaffId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([vendorStaffId, productId])
  @@index([productId])
}

// Bloque 198 (pedido explícito — "los usuarios podrán registrar sus ventas
// diarias manualmente... y así su inventario para ese usuario se va
// rebajando, y la tienda va rebajando el inventario general también"): cada
// fila es una venta fuera del sitio (puerta a puerta, mayoreo) que un
// usuario de sistema carga a mano — descuenta a la vez su propia
// VendorStaffAllocation.remainingQty Y Product.stock real, en la misma
// transacción atómica (ver registerManualSale, controller). `productName`
// es una copia congelada al momento de la venta — sobrevive aunque el
// producto se borre o le cambien el nombre después.
model VendorStaffSale {
  id            String   @id @default(cuid())
  vendorId      String
  vendorStaffId String
  productId     String?
  productName   String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  note          String?
  createdAt     DateTime @default(now())

  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorStaff VendorStaff @relation(fields: [vendorStaffId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([vendorStaffId, createdAt])
}

// Bloque 198 (pedido explícito — "se enviará un correo a los usuarios que
// ese día tienen que ir y reportar todas las ventas... el administrador
// podrá ver qué cantidad de dinero tiene que declarar el usuario"): un
// usuario marca un período (día/semana/mes, según Vendor.cashCloseFrequency)
// como ya reportado/depositado — `totalSales` queda congelado al momento
// del reporte (una venta corregida después no debe desordenar un cuadre ya
// hecho). Sirve para que el dueño vea, por período, quién reportó y quién
// no (ver getCashCloseStatus, controller).
model VendorStaffCashClose {
  id            String   @id @default(cuid())
  vendorStaffId String
  periodStart   DateTime
  periodEnd     DateTime
  totalSales    Decimal  @db.Decimal(12, 2)
  reportedAt    DateTime @default(now())
  note          String?

  vendorStaff VendorStaff @relation(fields: [vendorStaffId], references: [id], onDelete: Cascade)

  @@index([vendorStaffId, periodStart])
}

enum CashCloseFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// Bloque 200 (pedido explícito — "al crear un usuario, este usuario se
// puede crear como agente de ventas o mesero... cuando se crea un usuario
// con agente de ventas, automáticamente se debe habilitar una sección en
// el perfil del usuario"): clasificación opcional de un VendorStaff — null
// = sin tipo específico (comportamiento de siempre, 100% manual). Elegir un
// tipo es solo un ATAJO que precarga la(s) sección(es) que ese rol
// normalmente necesita (ver STAFF_TYPE_DEFAULT_SECTIONS,
// constants/vendorSections.js) — el dueño sigue pudiendo agregar/quitar
// secciones a mano después, nunca queda forzado por el tipo.
enum VendorStaffType {
  SALES_AGENT
  WAITER
}

// Bloque 62: auditoría de cada cambio de Vendor.status a través del tiempo
// — la columna status solo guarda el estado ACTUAL, esto guarda el
// historial completo (cuándo, por qué, quién). byAdminId null = cambio
// automático (el cron de suspensión por inactividad); seteado = un admin lo
// hizo a mano (reactivación desde AdminSuspendedVendors.jsx).
model VendorStatusLog {
  id         String       @id @default(cuid())
  vendorId   String
  fromStatus VendorStatus
  toStatus   VendorStatus
  reason     String?
  byAdminId  String?
  at         DateTime     @default(now())

  vendor  Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  byAdmin User?  @relation(fields: [byAdminId], references: [id], onDelete: SetNull)
}

// Bloque 62: un solo correo de "re-enganche" por (cliente, tienda, oferta)
// — sin esto, el job diario mandaría el mismo correo cada día mientras la
// oferta siga activa. Acotado a Offer (no StoreOffer) a propósito: es el
// modelo con imageUrl/discountLabel ya listos para una tarjeta de email;
// cubrir StoreOffer también queda como posible extensión, no se hizo acá
// para no duplicar la lógica de armado del correo con dos formas distintas.
model WinbackEmailLog {
  id         String   @id @default(cuid())
  customerId String
  vendorId   String
  offerId    String
  sentAt     DateTime @default(now())

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  offer    Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([customerId, vendorId, offerId])
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
}

model VendorLocation {
  id             String  @id @default(cuid())
  vendorId       String
  // Bloque 114 (pedido explícito): fuera de Cuba ya no se elige una
  // provincia/estado del catálogo — `provinceId` pasa a ser opcional y se
  // suma `countryId` (siempre requerido) + `stateOther` (nombre del
  // estado/provincia escrito a mano). Con Cuba: `countryId` apunta a CUBA,
  // `provinceId`/`municipalityId` mandan y `stateOther` queda null. Con
  // cualquier otro país real: `provinceId`/`municipalityId` quedan null,
  // `stateOther` manda (la dirección en sí vive en Vendor.companyAddress,
  // no hace falta duplicarla acá — un vendedor registra un solo local).
  countryId      String?
  provinceId     String?
  municipalityId String?
  stateOther     String?

  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  country      Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  province     Province?     @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
}

// Bloque 171 (pedido explícito — "si hay varios horarios un mismo día", ej.
// abre 9-12 y 2-6 con un cierre de mediodía): cada fila es UN tramo, no "el"
// horario del día — un mismo (vendorId, dayOfWeek) puede tener varias filas
// ahora (antes @@unique([vendorId, dayOfWeek]) obligaba a un solo tramo por
// día). Un día cerrado se representa con una única fila isClosed:true (sin
// tramos reales) — mismo criterio de siempre, ver isVendorOpenNow.
model VendorSchedule {
  id        String  @id @default(cuid())
  vendorId  String
  dayOfWeek Int // 0 = domingo .. 6 = sábado
  opensAt   String // "09:00"
  closesAt  String // "18:00"
  isClosed  Boolean @default(false)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, dayOfWeek])
}

// ---------------------------------------------------------------------------
// Pedidos (WhatsApp / contra entrega / transferencia CUP — sin Stripe/PayPal)
// ---------------------------------------------------------------------------

model Order {
  id                     String       @id @default(cuid())
  code                   String       @unique
  vendorId               String
  customerId             String?
  customerName           String?
  customerPhone          String?
  customerEmail          String?
  shippingAddress        String?
  shippingProvinceId     String?
  shippingMunicipalityId String?
  total                  Decimal      @db.Decimal(12, 2)
  status                 OrderStatus  @default(NEW)
  // Bloque 197 (pedido explícito — "quiero poder agregar una función para
  // eliminar pedido... no se elimina y sigue quedando registrado pero no
  // marcará diferencia de ventas ni inventario... esto se puede hacer para
  // pedidos erróneos"): mismo criterio que TableOrder.cancelReason — nunca
  // se borra la fila, solo se anula (status CANCELLED) con un motivo que
  // queda visible tanto en el panel del vendedor como en "Mis pedidos" del
  // cliente.
  cancelReason           String?
  channel                OrderChannel
  // Snapshot de Vendor.orderDestination al momento del pedido — distinto del
  // método de pago (channel): esto es "a dónde le llega el aviso al
  // vendedor" (WhatsApp o su panel), no "cómo paga el cliente".
  notificationChannel    OrderDestination @default(WHATSAPP)
  tableNumber            Int?
  createdAt              DateTime     @default(now())

  // Bloque 52: código de descuento del vendedor aplicado a este pedido, si
  // hubo uno — SetNull en vez de Cascade porque borrar/desactivar un código
  // después no debe borrar el historial de pedidos que ya lo usaron.
  // discountAmount es el monto ya restado del total de arriba (total =
  // subtotal - discountAmount), guardado aparte para poder mostrarlo en el
  // detalle del pedido sin tener que recalcularlo contra un código que puede
  // haber cambiado de valor/estado después.
  discountCodeId String?
  discountAmount Decimal? @db.Decimal(12, 2)

  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customer User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  emailLogs EmailLog[]
}

// Historial de emails transaccionales (confirmación, cambio de estado,
// manual). Nunca se registra SENT si Resend devolvió error — ver lib/email.js.
// El límite mensual de emails manuales del Plan Regular se calcula contando
// filas MANUAL+SENT del mes calendario en curso (nunca un contador aparte
// que se pueda desincronizar).
model EmailLog {
  id        String      @id @default(cuid())
  vendorId  String?
  orderId   String?
  type      EmailType
  to        String
  subject   String
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

// Bloque 33: registro centralizado de errores técnicos reales — nunca se
// muestra fuera de Admin (ver errorHandler.js + AdminErrors.jsx). El
// try/catch que ya existe en cada punto de falla sigue funcionando igual
// que antes (esto nunca lo reemplaza), es un registro ADICIONAL para que
// el admin tenga un solo lugar donde ver qué está fallando de verdad, sin
// tener que revisar logs de servidor a mano.
model ErrorLog {
  id     String      @id @default(cuid())
  origin ErrorOrigin
  message String
  // Datos de diagnóstico flexibles según el origen (ej. vendorId,
  // sessionId, endpoint, código de estado del proveedor externo) — nunca
  // contraseñas ni datos sensibles del cliente.
  context   Json?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
  @@index([origin, createdAt])
}

enum ActivityActorRole {
  VENDOR
  CUSTOMER
  // Bloque 183: acción hecha por un usuario del panel del vendedor que NO
  // es el dueño — actorId ya distingue exactamente CUÁL (join a User/
  // VendorStaff), este valor es lo que separa a simple vista "lo hizo el
  // dueño" de "lo hizo un usuario con acceso" en Admin > Actividad y en el
  // historial que ve el propio vendedor.
  VENDOR_STAFF
}

// Bloque 70 (pedido explícito): registro general de acciones de vendedores y
// clientes en sus paneles/cuenta — le da al admin un historial completo
// ("todo lo que hacen") y una base para calcular uso por día/semana/mes
// (ver getActivityStats en admin.controller.js). No reemplaza los logs ya
// existentes que auditan UNA transición puntual (VendorStatusLog,
// VerificationStatusLog) — este es de propósito general, por eso `action` es
// texto libre (no un enum): agregar un nuevo tipo de acción a registrar
// nunca debe necesitar una migración. `vendorId` es nulo para acciones de un
// cliente que no involucran ninguna tienda en particular (ej. actualizar su
// perfil); `description` ya viene armado en español, listo para mostrar sin
// que el frontend tenga que interpretar `action`/`meta`.
model ActivityLog {
  id          String            @id @default(cuid())
  actorId     String
  actorRole   ActivityActorRole
  vendorId    String?
  action      String
  description String
  meta        Json?
  createdAt   DateTime          @default(now())

  actor  User    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([vendorId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String?
  name            String
  quantity        Int
  price           Decimal @db.Decimal(12, 2)
  selectedOptions Json?
  // Bloque 52: talla elegida, si el producto tiene Product.sizes cargadas —
  // campo propio (no reusar selectedOptions, que ya es de ProductOption/menú)
  // para poder decrementar sizeStock[size] puntualmente al confirmar la venta.
  size            String?
  currency        ProductCurrency @default(CUP)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Restaurantes: mesas + QR + estado de cocina
// ---------------------------------------------------------------------------

model Table {
  id          String @id @default(cuid())
  vendorId    String
  tableNumber Int
  qrToken     String @unique @default(cuid())
  // Bloque 141: nombre propio opcional (ej. "Terraza 1") — si no se carga,
  // se sigue mostrando "Mesa {tableNumber}" en todos lados.
  label       String?

  vendor      Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  tableOrders TableOrder[]
  // Bloque 157: lado inverso de Product.restrictedTables.
  restrictedProducts Product[] @relation("ProductTableRestriction")

  @@unique([vendorId, tableNumber])
}

model TableOrder {
  id            String        @id @default(cuid())
  tableId       String
  // Bloque 158 (pedido explícito — "los pedidos... se rastrearán por un
  // número de pedido único"): autoincrement propio, GLOBAL (no por mesa ni
  // por vendedor — no hace falta, alcanza con que sea único y fácil de leer
  // en voz alta/mostrar en pantalla). `id` (cuid) sigue siendo la clave real
  // para buscar el pedido (ver getTableOrderStatus) — esto es puramente para
  // mostrarle al cliente/vendedor "Pedido #123" en vez de un cuid ilegible.
  orderNumber   Int           @unique @default(autoincrement())
  items         Json
  total         Decimal       @db.Decimal(12, 2)
  kitchenStatus KitchenStatus @default(RECEIVED)
  // Bloque 16: nullable por compatibilidad con pedidos de mesa viejos sin
  // email. Bloque 141 (pedido explícito — "el cliente solo debe poner su
  // nombre y más nada"): dejó de ser obligatorio — ahora es 100% opcional,
  // solo se usa para avisar por correo si el cliente lo da igual.
  customerEmail String?
  // Bloque 141: obligatorio para cualquier pedido NUEVO (ver
  // createTableOrderSchema, tables.controller.js) — nullable acá solo por
  // compatibilidad con pedidos de mesa creados antes de este bloque.
  customerName  String?
  createdAt     DateTime      @default(now())
  // Bloque 158 (pedido explícito — "si el vendedor modifica su pedido, el
  // cliente podrá ver el pedido modificado"): se actualiza sola en CUALQUIER
  // cambio a esta fila (Prisma @updatedAt) — TableOrder.jsx (cliente) la usa
  // para saber si lo que ve ahora es distinto de la última vez que consultó,
  // sin necesitar una tabla de historial aparte.
  updatedAt     DateTime      @updatedAt
  // "Ocupada"/"Libre" en VendorTables.jsx pasa de depender de kitchenStatus
  // (llegar a READY ya liberaba la mesa) a depender de esto: el vendedor
  // marca a mano que el cliente pagó y se retiró (ver clearTableOrder en
  // tables.controller.js). null = la mesa sigue ocupada aunque el pedido ya
  // esté en READY/"Listo".
  clearedAt DateTime?
  // Bloque 163 (pedido explícito — "la mesa debe mantenerse ocupada... hasta
  // que se entregue el pedido en la mesa... el camarero ponga en el sistema
  // que el pedido fue entregado"): momento DISTINTO de clearedAt a
  // propósito — clearedAt es "el cliente ya pagó y se fue" (bastante
  // después, puede tardar toda la comida); deliveredAt es "el mesero ya le
  // llevó el pedido a la mesa", el punto real donde otra persona de la
  // MISMA mesa puede pedir algo más sin pisar un pedido todavía sin
  // entregar. null = la mesa sigue bloqueada para pedidos nuevos de
  // cualquier otro dispositivo (ver createTableOrder/getTableByToken).
  deliveredAt DateTime?
  // Bloque 167 (pedido explícito — "cuando se cancela un pedido no se debe
  // borrar del todo, siempre los movimientos deben quedar registrados... se
  // debe insertar un motivo y los clientes pueden ver ese motivo y quedará
  // registrado en el panel del vendedor"): reemplaza el borrado real que
  // hacía cancelTableOrder antes de este bloque — ahora es un estado más
  // (no un enum nuevo en KitchenStatus a propósito: cancelar no es un paso
  // de cocina, es una salida aparte del flujo normal), consultado en vez de
  // deliveredAt en cualquier chequeo de "mesa ocupada"/"pedidos pendientes"
  // (ver createTableOrder, getTableByToken, listPendingTableOrders) para
  // que un pedido cancelado no siga bloqueando la mesa ni aparezca en el
  // popup de pedido nuevo, pero SIGA visible en el historial de Pedidos.
  cancelledAt  DateTime?
  cancelReason String?
  // Bloque 177 (bug real reportado en vivo — "un cliente con una mesa
  // ocupada y una cuenta abierta agregó productos... eso no se notificó en
  // el panel del vendedor, se registró en la cuenta pero no como un pedido
  // nuevo — debe notificarse igual siempre que se pida desde la mesa,
  // aunque la cuenta ya esté abierta"): createTableOrder (tables.controller.js)
  // tiene 2 ramas — crear (kitchenStatus arranca en RECEIVED, YA dispara el
  // popup/sonido vía listPendingTableOrders) y sumar a una cuenta ya
  // aceptada (el kitchenStatus NO vuelve a RECEIVED a propósito, para no
  // re-bloquear la mesa) — esa segunda rama nunca avisaba nada. Este campo
  // es la señal de "el CLIENTE agregó algo que el vendedor todavía no vio"
  // — se pone en la rama de sumar (nunca cuando el propio vendedor agrega
  // consumo a mano, ver addTableOrderItem/createManualTableOrder) y se
  // limpia cuando el vendedor lo reconoce (ackCustomerTableOrderUpdate).
  customerUpdatedAt DateTime?
  // Bloque 178 (pedido explícito — "se debe marcar de todos los pedidos
  // cuál es el último que se agregó... no se puede confundir el
  // camarero"): cuántos items del final del array `items` corresponden a
  // la última ronda que agregó el CLIENTE (mismo momento que
  // customerUpdatedAt de arriba, siempre juntos) — el frontend resalta
  // `items.slice(-lastCustomerAddCount)` en vez de necesitar guardar una
  // copia de esos items aparte. Mismo ciclo de vida que customerUpdatedAt:
  // se pone en la rama de sumar de createTableOrder, se limpia en
  // ackCustomerTableOrderUpdate.
  lastCustomerAddCount Int?

  // Bloque 188 (pedido explícito — "agregar alertas al sistema... cuando a
  // un usuario o vendedor se le olvida cerrar una mesa o un pedido, es
  // decir el pedido está aún en estado de preparando pero ya se entregó en
  // la mesa"): momento del ÚLTIMO avance real de estado (aceptar, marcar
  // listo, entregado) — a propósito, NUNCA `updatedAt` (ese campo cambia
  // con CUALQUIER edición de la fila, incluido agregar un item o que el
  // cliente sume consumo, lo que haría ver "reciente" un pedido cuyo
  // estado de cocina en realidad lleva horas sin moverse). Es lo que
  // listStaleTableOrders usa para decidir "hace cuánto está en este
  // estado" — se resetea en updateKitchenStatus/markTableOrderDelivered
  // (nunca en clearTableOrder, que ya saca al pedido del chequeo de
  // "olvidado" vía `clearedAt`).
  statusChangedAt DateTime @default(now())
  // Bloque 188: el vendedor puede responder "sigue igual" a la alerta —
  // esto pospone el próximo aviso por un rato en vez de mostrárselo de
  // nuevo en el siguiente poll (ver snoozeStaleReminder). null = nunca
  // pospuesto, o ya venció el plazo.
  staleReminderSnoozedUntil DateTime?

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, clearedAt])
  @@index([tableId, deliveredAt])
  @@index([tableId, cancelledAt])
  @@index([tableId, customerUpdatedAt])
}

// ---------------------------------------------------------------------------
// KYC — fotos privadas, nunca públicas (servir por endpoint autenticado)
// ---------------------------------------------------------------------------

model VerificationRequest {
  id              String             @id @default(cuid())
  vendorId        String             @unique
  // Bloque 64: perdió su propio `status` — el estado vive solo en
  // `Vendor.verificationStatus` de ahora en más (ver ese enum para el porqué).
  // Este modelo sigue siendo el que guarda los documentos/datos de la fase
  // de pago en curso.
  fullName        String?
  idNumber        String?
  // Bloque 66: qué documento presentó (carné cubano / pasaporte / carné de
  // extranjería) — el pasaporte no tiene reverso, ver el gate opcional de
  // idPhotoBackUrl en submitVerification según este valor.
  idDocumentType  IdDocumentType?
  idPhotoFrontUrl String?
  idPhotoBackUrl  String?
  selfieUrl       String?
  // Bloque 146 (pedido explícito): video corto de liveness — el cliente gira
  // la cabeza a la izquierda y a la derecha mientras se graba, además de la
  // selfie frontal (ver CameraCapture.jsx). Opcional a nivel de columna: si
  // el navegador no soporta detección de rostro/MediaRecorder (Safari/
  // Firefox viejos), el trámite sigue funcionando solo con la foto, nunca
  // bloquea el envío por esto.
  selfieVideoUrl  String?
  notes           String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())

  // Bloque 16: fase de cobro, solo relevante una vez que status llega a
  // PENDING_PAYMENT. paymentConfirmedById nulo + paymentConfirmedAt seteado
  // = confirmación automática (Stripe, vía webhook); con admin = transferencia
  // CUP confirmada a mano — mismo patrón que reviewedById nulo = decisión
  // automática, usado arriba para la fase de documentos.
  paymentMethod        VerificationPaymentMethod?
  paymentProofUrl       String?
  // Bloque 66 (pedido explícito): el comprobante deja de ser obligatorio —
  // el vendedor puede reclamar el pago ("Ya pagué") con o sin archivo
  // adjunto. paymentClaimedAt es lo que se setea SIEMPRE al llamar ese
  // endpoint (con o sin archivo) — dispara el aviso por correo al admin y es
  // lo que el panel de admin muestra como "esperando confirmación".
  paymentClaimedAt     DateTime?
  paymentConfirmedAt    DateTime?
  paymentConfirmedById  String?

  // Bloque 25: reemplaza el link de pago simulado propio (paymentLinkToken)
  // por un Checkout Session real de Stripe. stripeCheckoutSessionId
  // identifica la sesión vigente (se compara contra el webhook para no
  // activar por un evento de una sesión vieja); stripeCheckoutUrl es lo que
  // el vendedor abre; stripeCheckoutExpiresAt es cuándo Stripe la vence
  // (Checkout Sessions expiran solas, típicamente a las 24h) — pasado ese
  // momento el frontend ofrece "generar un link nuevo" en vez de mostrar
  // uno muerto.
  stripeCheckoutSessionId String?
  stripeCheckoutUrl       String?
  stripeCheckoutExpiresAt DateTime?

  // Bloque 150 (pedido explícito): el vendedor elige cuántos meses paga por
  // adelantado (1..24) — el monto total es precio mensual × meses, tanto en
  // CUP (transferencia) como en USD (Stripe). paymentAmount/paymentCurrency
  // es lo que el VENDEDOR declara haber pagado al subir el comprobante (lo
  // que el admin compara contra el total esperado), no el precio de lista.
  paymentMonths   Int?
  paymentAmount   Decimal? @db.Decimal(12, 2)
  paymentCurrency String?
  // Datos de quién hizo el pago — obligatorios al subir el comprobante.
  // payerName tiene que coincidir con el titular de la tarjeta / de la
  // cuenta que transfirió. payerAccountNumber solo aplica a CUP.
  // payerCardLast4: NUNCA el número completo de la tarjeta (PCI — este
  // sistema no está certificado para guardarlo; Stripe ya lo tiene), solo
  // los últimos 4 dígitos, suficientes para conciliar contra el dashboard.
  payerName          String?
  payerAccountNumber String?
  payerPhone         String?
  payerAddress       String?
  payerCountry       String?
  payerCardLast4     String?
  // "No pude hacer la captura" — el comprobante deja de ser obligatorio a
  // cambio de los datos adicionales de arriba (teléfono/dirección/país/
  // últimos 4 dígitos), para que el admin igual pueda conciliar el pago.
  paymentProofUnavailable Boolean @default(false)
  // Bloque 150: Stripe confirma el cobro por webhook (checkout.session.
  // completed) pero YA NO activa la verificación solo — deja esta marca, el
  // vendedor sube su comprobante igual que con CUP, y un admin finaliza a
  // mano viendo las 2 cosas juntas (ver confirmSubscriptionPayment).
  stripePaidAt          DateTime?
  stripePaymentIntentId String?
  // Bloque 150: rama de archivo del CICLO EN CURSO — se crea al enviar los
  // documentos (no al verificarse, como antes) y se va completando con cada
  // paso (revisión, pago reclamado, confirmado, verificado/rechazado) — ver
  // syncVerificationArchive en vendorVerification.service.js. Se reemplaza
  // por una rama nueva en cada reenvío; la vieja queda intacta.
  archiveId String? @unique

  vendor            Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviewedBy        User?  @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  paymentConfirmedBy User? @relation("PaymentConfirmedBy", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)
  archive           VerificationArchive? @relation("VerificationRequestArchive", fields: [archiveId], references: [id], onDelete: SetNull)
}

// Bloque 64: auditoría completa de cada cambio de Vendor.verificationStatus —
// la columna en Vendor solo guarda el estado ACTUAL, esto guarda el
// historial (cuándo, de dónde a dónde, por qué, quién si fue un admin).
// Cubre el "verificationHistory" pedido explícitamente, sin duplicar el
// historial de pagos de Stripe (ese ya vive en el propio dashboard de
// Stripe, consultable en vivo por stripeCustomerId).
model VerificationStatusLog {
  id         String                   @id @default(cuid())
  vendorId   String
  fromStatus VendorVerificationStatus
  toStatus   VendorVerificationStatus
  reason     String?
  actorId    String?
  source     VerificationStatusSource
  at         DateTime                 @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// Bloque 72 (pedido explícito): archivo PERMANENTE de la documentación que
// llevó a una tienda a quedar verificada — hora, fecha, datos personales y
// del negocio, fotos del responsable y de la identificación, todo archivado.
// Una fila nueva ("rama") por cada verificación exitosa (creada automática
// al llegar a VERIFIED, ver transitionVendorVerification en
// vendorVerification.service.js) — nunca se reemplaza ni se pisa: si la
// tienda pierde la verificación y vuelve a pagar/enviar documentación más
// adelante, esa segunda verificación exitosa crea una rama NUEVA, la vieja
// queda intacta. Es un snapshot independiente — guarda nombres resueltos de
// país/provincia/municipio (no FKs) para seguir siendo legible aunque esas
// tablas de referencia cambien después. Editable (correcciones de datos),
// pero solo eliminable a mano por un admin y SOLO si la tienda YA NO está
// verificada (ver deleteVerificationArchive) — nunca un borrado automático.
model VerificationArchive {
  id       String @id @default(cuid())
  vendorId String

  companyName    String
  ownerName      String?
  ownerIdNumber  String?
  companyTaxId   String?
  companyAddress String?
  description    String?

  idDocumentType          IdDocumentType?
  fullName                String?
  idNumber                String?
  registrationCountryName String?
  legalProvinceName       String?
  legalMunicipalityName   String?

  // Mismos archivos que VerificationRequest en el momento de verificarse —
  // nunca se borran del disco al archivar (ver submitVerification).
  selfieUrl       String?
  idPhotoFrontUrl String?
  idPhotoBackUrl  String?
  // Bloque 146: mismo campo que VerificationRequest — se archiva junto con
  // el resto si se capturó.
  selfieVideoUrl  String?

  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedById String?

  // Bloque 150 (pedido explícito — "debe quedar archivado todo el historial
  // de todo lo que la tienda ha enviado, y toda actividad con hora y fecha,
  // desde que el cliente envía la solicitud"): la rama ya no se crea recién
  // al verificarse — se crea al ENVIAR los documentos y se completa paso a
  // paso. Estos campos son el espejo del ciclo de pago de esa solicitud
  // puntual (VerificationRequest se reinicia en cada reenvío; acá queda lo
  // que pasó en ESTE ciclo, para siempre). verifiedAt/rejectedAt marcan
  // cómo terminó el ciclo (null en los 2 = todavía en curso).
  paymentMethod           VerificationPaymentMethod?
  paymentMonths           Int?
  paymentAmount           Decimal? @db.Decimal(12, 2)
  paymentCurrency         String?
  payerName               String?
  payerAccountNumber      String?
  payerPhone              String?
  payerAddress            String?
  payerCountry            String?
  payerCardLast4          String?
  paymentProofUrl         String?
  paymentProofUnavailable Boolean @default(false)
  paymentClaimedAt        DateTime?
  stripePaidAt            DateTime?
  paymentConfirmedAt      DateTime?
  paymentConfirmedById    String?
  verifiedAt              DateTime?
  rejectedAt              DateTime?

  notes     String?
  archivedAt DateTime @default(now())

  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("VerificationArchiveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  request    VerificationRequest? @relation("VerificationRequestArchive")

  @@index([vendorId, archivedAt])
}

// Bloque 153 (pedido explícito — "una vez el cliente esté verificado, en la
// sección de suscripción podrá ver cuántos días vence... y podrá activar un
// nuevo mes o varios... se guardará todo ese historial"): un pago de
// RENOVACIÓN mientras la tienda YA está VERIFIED — a propósito un modelo
// SEPARADO del ciclo inicial (VerificationRequest, que sigue intacto tal
// cual quedó en los Bloques 150-152, nunca se reutiliza para esto) — cada
// renovación es una fila propia e inmutable una vez confirmada, nunca se
// pisa con la siguiente (a diferencia de VerificationRequest, que si se
// reutiliza dentro de SU propio ciclo). Mismos campos/criterio que ya
// probó el ciclo inicial (método, meses, quién pagó, comprobante,
// reclamo/confirmación) para que el proceso se sienta "casi igual", como
// se pidió.
model SubscriptionPayment {
  id       String @id @default(cuid())
  vendorId String

  paymentMethod VerificationPaymentMethod
  months        Int
  amount        Decimal? @db.Decimal(12, 2)
  currency      String

  payerName          String?
  payerAccountNumber String?
  payerPhone         String?
  payerAddress       String?
  payerCountry       String?
  payerCardLast4     String?
  proofUrl            String?
  proofUnavailable    Boolean @default(false)

  stripeCheckoutSessionId String?
  stripeCheckoutUrl       String?
  stripeCheckoutExpiresAt DateTime?
  stripePaidAt            DateTime?
  stripePaymentIntentId   String?

  claimedAt    DateTime?
  confirmedAt  DateTime?
  confirmedById String?
  // Bloque 153: período real que este pago cubre — periodStart es el
  // vencimiento ANTERIOR (o el momento de la confirmación si no había
  // ninguno vigente), periodEnd = periodStart + months. Pagar antes de que
  // venza el ciclo actual extiende desde el vencimiento real, nunca desde
  // "ahora" — así nunca se pierden días ya pagados por renovar temprano.
  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())

  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  confirmedBy User?  @relation("SubscriptionPaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
}

enum VendorChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Bloque 153 (pedido explícito — "todos los datos de la tienda no se pueden
// modificar después de estar verificadas sin aprobación del admin... si se
// desea cambiar el nombre o el responsable se debe enviar la solicitud al
// admin para prevenir fraudes y en caso dado subir fotos del nuevo
// responsable y foto del ID"): campos de identidad propuestos como String
// null = "sin cambio en este campo" (patch parcial, no todos los campos
// tienen que reenviarse). Las fotos son opcionales — solo hacen falta
// cuando cambia el RESPONSABLE (la persona, no solo el nombre en texto).
model VendorChangeRequest {
  id       String @id @default(cuid())
  vendorId String

  companyName    String?
  ownerName      String?
  ownerIdNumber  String?
  companyTaxId   String?
  companyAddress String?

  newOwnerSelfieUrl String?
  newOwnerIdPhotoUrl String?

  reason String? @db.Text

  status       VendorChangeRequestStatus @default(PENDING)
  adminNotes   String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("VendorChangeRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
}

// ---------------------------------------------------------------------------
// Bloque 46: anuncios programados (banners públicos del marketplace, no de
// una tienda puntual) — page: ALL aparece en todas las páginas públicas que
// consulten GET /announcements/active, HOME/STORES restringen a una sola.
// ---------------------------------------------------------------------------

enum AnnouncementPage {
  HOME
  STORES
  ALL
}

enum AnnouncementPosition {
  HERO
  TOP_BAR
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  body      String?
  page      AnnouncementPage
  position  AnnouncementPosition
  imageUrl  String?
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
}

// ---------------------------------------------------------------------------
// Admin: campañas (Resend) e integraciones (credenciales cifradas en DB)
// ---------------------------------------------------------------------------

model Campaign {
  id         String         @id @default(cuid())
  title      String
  channel    String         @default("email")
  segment    String         @default("all_customers") // all_customers | all_vendors | regular_vendors | business_vendors
  provinceId String? // null = toda Cuba
  subject    String?
  content    String?
  // Bloque 67 (pedido explícito): personalización de la campaña — banner
  // arriba del mensaje (archivo subido a /uploads/site o link externo, mismo
  // criterio que announcements/store-offers) y botón de llamado a la acción
  // opcional. ctaLabel/ctaUrl van siempre juntos (validado en el controller,
  // no acá) — un botón no tiene sentido con uno solo de los dos.
  imageUrl   String?
  ctaLabel   String?
  ctaUrl     String?
  status     CampaignStatus @default(DRAFT)
  sentCount  Int            @default(0)
  openCount  Int            @default(0)
  createdAt  DateTime       @default(now())
  sentAt     DateTime?
}

// Credenciales cifradas con AES-256-GCM (ver lib/crypto.js) — nunca en .env.
model Integration {
  id                   String   @id @default(cuid())
  name                 String   @unique
  credentialsCiphertext String
  credentialsIv        String
  credentialsAuthTag   String
  // Solo usado por "resend" por ahora: dirección verificada del dominio
  // propio (ej. notificaciones@midominio.cu). No es secreto — va en texto
  // plano a diferencia de la clave. Si es null, se cae a onboarding@resend.dev.
  fromEmail            String?
  isActive             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Configuración global del sitio (fila única) — hoy solo las imágenes del
// hero-slider de Home.jsx; si no hay fila o heroImages está vacío, el
// frontend usa el placeholder actual (nunca rompe el layout).
// ---------------------------------------------------------------------------

model SiteSettings {
  id String @id @default(cuid())
  // Bloque 96 (pedido explícito): el hero de la Home pasa de una sola
  // imagen fija a un slider — reemplaza a heroImageUrl (mismo patrón
  // String[] que planFeaturesRegular/Business más abajo). Guarda rutas
  // relativas completas ("/uploads/site/<archivo>"), mismo criterio que
  // Product.images, así no hay que reconstruir el prefijo en cada lugar
  // que lo lee. El orden del array es el orden real del slider.
  heroImages String[] @default([])
  // Bloque 49: nombre y logo de la plataforma, editables desde "Marca de la
  // plataforma" en el admin — consumidos en todo el sitio (header, footer,
  // <title>, emails, PDFs, WhatsApp) vía usePlatformSettings() en vez de un
  // string "ZeuDin" hardcodeado. siteName con default "ZeuDin" para no
  // cambiar el comportamiento visible al desplegar esta migración.
  siteName String  @default("ZeuDin")
  logoUrl  String?
  // Bloque 61: redes de la plataforma — usadas hoy por la fila de íconos del
  // footer de los correos ("Marca de la plataforma" en el admin), y a futuro
  // por el footer del sitio. null = ese ícono/link simplemente no se
  // muestra (nunca un link inventado/placeholder). El de "sitio web" no
  // necesita columna propia — siempre es env.frontendUrl.
  whatsappUrl  String?
  instagramUrl String?
  facebookUrl  String?
  // Bloque 75 (pedido explícito): número de soporte en formato E.164 (ej.
  // +5355512345) — DISTINTO de whatsappUrl de arriba (ese es un link
  // cualquiera para el ícono del pie de los correos; este es un número
  // crudo para poder armar un deep link de WhatsApp con mensaje
  // prellenado). Lo usa el botón "Contactar soporte" que ve un vendedor con
  // la tienda bloqueada o suspendida (VendorLayout.jsx) — cambiarlo acá
  // actualiza el botón en todos lados, sin tocar código.
  supportWhatsapp String?
  // Límites por plan — cuántos países de entrega y provincias de Cuba puede
  // tener cargados un vendedor a la vez. Nunca hardcodeados en el código:
  // el admin los edita desde AdminLocations.jsx. null en el máximo de
  // provincias Business = sin límite (Plan Business es "ilimitado" por
  // definición del negocio, pero se deja como campo editable igual, no una
  // constante, por si el admin algún día quiere ponerle un tope).
  maxDeliveryCountriesRegular  Int  @default(1)
  maxDeliveryCountriesBusiness Int  @default(5)
  maxProvincesRegular          Int  @default(1)
  maxProvincesBusiness         Int?
  // Bloque 43/45: nombre de modelo por proveedor de IA, editable desde
  // AdminIntegrations.jsx — null/vacío = usa el default hardcodeado en el
  // archivo del proveedor (lib/nvidia.js, groq.js, gemini.js). Antes esto
  // era una constante MODEL en cada archivo; moverlo acá permite que el
  // admin reaccione a una deprecación de modelo (ya pasó 2 veces con Groq)
  // sin tocar código ni redesplegar. Bloque 45: Cerebras salió del sistema
  // (su cuenta gratuita devolvía 402 Payment Required) — aiModelCerebras
  // se elimina, aiModelNvidia lo reemplaza como tercer proveedor.
  aiModelGroq   String?
  aiModelGemini String?
  aiModelNvidia String?
  // Listas de qué incluye cada plan (Regular/Business), mostradas en
  // VendorVerification.jsx/VendorSubscription.jsx — editable desde
  // AdminSubscriptions.jsx. Antes era el array hardcodeado PLANS[].features
  // en frontend/src/lib/verificationMeta.js; el default de acá es
  // exactamente ese mismo array, para no cambiar el comportamiento al
  // desplegar. Solo la lista de features es dinámica — id/nombre/priceLabel
  // del plan siguen siendo estáticos (no forman parte de este pedido).
  planFeaturesRegular  String[] @default(["Hasta 20 productos", "Pedidos por WhatsApp", "Perfil de tienda público", "Sin comisiones por venta"])
  planFeaturesBusiness String[] @default(["Productos ilimitados", "Sello de tienda verificada", "Destacada en la home", "Recomendaciones con IA", "Horarios de atención"])
  // Bloque 49: si el vendedor puede agregar imágenes de producto pegando un
  // link externo, además de subir el archivo. Apagable desde el admin porque
  // un link roto o de mala calidad es más difícil de moderar que un archivo
  // subido directamente al servidor.
  allowProductImageLinks Boolean @default(true)
  // Bloque 51: política de ofertas de vendedores, editable desde la sección
  // "Ofertas" del admin — antes eran constantes hardcodeadas en
  // offers.controller.js (OFFER_COOLDOWN_DAYS/OFFER_DEFAULT_DURATION_DAYS).
  // offerCooldownDays: cada cuántos días un vendedor verificado puede
  // publicar/republicar una oferta nueva. offerDefaultDurationDays: cuánto
  // dura activa una oferta cuando el vendedor no pide una duración custom.
  // Los defaults son los mismos valores que ya estaban hardcodeados, para no
  // cambiar el comportamiento visible al desplegar esta migración.
  offerCooldownDays        Int @default(7)
  offerDefaultDurationDays Int @default(30)
  // Bloque 232 (pedido explícito — "quiero poder cambiar desde el panel de
  // admin si los vendedores pueden tener una oferta activa en su tienda o
  // pueden tener más de una... los vendedores podrán ver cuántas ofertas
  // pueden tener activas"): a diferencia de offerCooldownDays/
  // offerDefaultDurationDays de arriba (política de Offer/Home), esto es
  // sobre StoreOffer (ofertas DENTRO de cada tienda) — cuántas puede
  // mantener `active:true` a la vez un mismo vendedor. Default 1 = el
  // comportamiento que pidió primero ("solo se podrá mantener una oferta
  // activa por tienda"), ahora editable sin deploy.
  maxActiveStoreOffersPerVendor Int @default(1)
  // Bloque 118 (pedido explícito): política de comentarios/reseñas,
  // editable desde "Comentarios" del admin — antes constantes hardcodeadas
  // en reviews.controller.js (REVIEW_DEDUP_HOURS=24, 1 por producto y 1 por
  // tienda fijos). reviewDedupHours es la ventana de tiempo (24 = "por
  // día"); maxReviewsPerProductPerPeriod/maxReviewsPerStorePerPeriod son 2
  // topes INDEPENDIENTES por esa ventana — reseñar un producto no consume
  // el cupo de otro producto ni el de la reseña general de la tienda (ver
  // Bloque 117). vendorsCanReview: si está en false, ninguna cuenta VENDOR
  // puede comentar/reseñar ninguna tienda o producto (ni la propia ni
  // ajena) — antes cualquier cuenta logueada podía, sin distinguir rol.
  // Los defaults son los mismos valores que ya estaban hardcodeados, para
  // no cambiar el comportamiento visible al desplegar esta migración.
  reviewDedupHours              Int     @default(24)
  maxReviewsPerProductPerPeriod Int     @default(1)
  maxReviewsPerStorePerPeriod   Int     @default(1)
  vendorsCanReview              Boolean @default(true)
  // Bloque 52: mostrar/ocultar el botón flotante del chatbot general
  // (MarketplaceChatWidget) en el Home público — antes montado sin
  // condición ninguna. Default true = mismo comportamiento visible de
  // siempre al desplegar esta migración.
  showChatWidget Boolean @default(true)
  // Bloque 52: de qué canales de pedido puede elegir un vendedor al cargar
  // un producto (VendorProducts.jsx) — antes las 3 opciones (whatsapp/cod/
  // prepaid) estaban hardcodeadas en el formulario sin que el admin pudiera
  // apagar ninguna. "whatsapp" es el canal universal (siempre disponible,
  // no aparece en esta lista porque no se puede desactivar — ver
  // products.controller.js) — acá solo viven los OPCIONALES.
  productPaymentMethods String[] @default(["cod", "prepaid"])
  // Bloque 65: de qué conjunto fijo (CUP/USD/EUR/MXN) puede elegir una
  // tienda su moneda operativa única al registrarse o al cambiarla después
  // — el admin activa/desactiva sin redesplegar, nunca texto libre (mismo
  // patrón que productPaymentMethods de arriba). Nunca puede quedar vacío
  // (validado en updateAvailableCurrencies) — un registro sin ninguna
  // moneda para elegir rompería el alta de tiendas nuevas.
  availableCurrencies String[] @default(["CUP", "USD", "EUR", "MXN"])
  // Bloque 64: datos bancarios de transferencia CUP para la suscripción del
  // Plan Business — antes hardcodeados a mano en VendorVerification.jsx
  // ("CI: 9205-XXXX-XXXX"), ahora editables desde el admin sin redesplegar.
  // null = el vendedor ve un aviso de "contacta al equipo" en vez de un dato
  // inventado (mismo criterio que whatsappUrl/etc. de Bloque 61).
  cupBankAccountNumber String?
  cupBankAccountHolder String?
  cupBankInstructions  String? @db.Text
  cupSubscriptionPriceCup Int @default(2500)
  // Bloque 150: precio mensual en USD del cobro con tarjeta vía Stripe —
  // antes una constante hardcodeada (SUBSCRIPTION_PRICE_USD = 25 en
  // lib/stripe.js), ahora editable junto al precio CUP desde el mismo lugar
  // del admin (AdminSubscriptions.jsx). Default 25 = mismo valor de siempre.
  cardSubscriptionPriceUsd Int @default(25)
  // Bloque 66 (pedido explícito): catálogo administrable de etiquetas que un
  // vendedor puede elegir para un producto (mismo patrón que
  // productPaymentMethods/availableCurrencies arriba) — "Nuevo" es un valor
  // fijo del sistema que NO vive en esta lista (siempre disponible, se
  // fuerza solo al crear el producto, nunca se puede desactivar). El admin
  // agrega/quita el resto desde AdminBranding.jsx sin redesplegar.
  availableProductBadges String[] @default(["Popular", "Solicitado"])
  // Cuántos días dura la etiqueta "Nuevo" antes de desaparecer sola (ver
  // expireNewBadges en products.controller.js) — contados desde
  // Product.activatedAt, no desde createdAt.
  newBadgeDurationDays Int @default(14)
  // Feature B (pedido explícito, confirmado con el usuario: 5 días): plazo
  // que tiene un vendedor/dueño de venta rápida para responder con evidencia
  // a un reporte de fraude antes de que fraudReports.job.js lo suspenda
  // solo — editable sin redeploy, mismo patrón que newBadgeDurationDays.
  fraudReportEvidenceDeadlineDays Int @default(5)
  // Bloque 85 (pedido explícito): zona horaria IANA (ej. "America/Havana"),
  // editable desde "Marca de la plataforma" en el admin — hoy solo la usa
  // aiHealthCheck.job.js para saber cuándo son las 3:00am de verdad para
  // este negocio (nunca hardcodeada a un solo país, a diferencia de
  // vendorLifecycle.job.js/verificationPayment.job.js, que sí corren fijo
  // en hora Cuba). lastAiHealthCheckAt evita que ese cron (que corre cada
  // hora y se autochequea) dispare 2 veces el mismo día si la hora 3am
  // coincide en más de un tick por cualquier motivo.
  timezone             String    @default("America/Havana")
  lastAiHealthCheckAt  DateTime?

  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Buzón de sugerencias (vendedor/cliente -> admin)
// ---------------------------------------------------------------------------

enum SuggestionAuthorType {
  VENDOR
  CUSTOMER
}

enum SuggestionStatus {
  NEW
  REVIEWED
}

model Suggestion {
  id         String               @id @default(cuid())
  authorId   String
  // Se guarda explícito en vez de derivarlo de User.role en cada lectura —
  // más simple de filtrar/mostrar, y congela el tipo aunque el role del
  // usuario cambie después (ej. un cliente que después abre una tienda).
  authorType SuggestionAuthorType
  message    String
  status     SuggestionStatus     @default(NEW)
  createdAt  DateTime             @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Bloque 15: analíticas de "clientes potenciales" + chat admin↔vendedor
// ---------------------------------------------------------------------------

// Tracking mínimo (no un sistema de analytics completo): solo lo necesario
// para armar "clientes potenciales" en VendorDashboard.jsx — clientes
// logueados que visitaron la tienda o agregaron algo al carrito pero nunca
// llegaron a pedir. Visitantes/carritos anónimos no se trackean (no hay con
// quién contactarlos, así que no sirven para esta métrica igual).
enum EngagementType {
  VISIT
  CART_ADD
}

model VendorEngagement {
  id         String         @id @default(cuid())
  vendorId   String
  customerId String
  type       EngagementType
  createdAt  DateTime       @default(now())

  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Un solo hilo por tienda (vendedor <-> equipo ZeuDin) — alcanza para el
// alcance pedido, no hace falta modelar conversaciones múltiples. senderRole
// identifica quién mandó cada mensaje; readAt es cuándo el OTRO lado
// (el que no mandó el mensaje) lo vio de verdad, no cuándo llegó al backend.
enum MessageSenderRole {
  VENDOR
  ADMIN
}

model VendorMessage {
  id         String            @id @default(cuid())
  vendorId   String
  senderRole MessageSenderRole
  senderId   String
  body       String
  readAt     DateTime?
  createdAt  DateTime          @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Bloque 16: campanita de notificaciones del panel de vendedor
// ---------------------------------------------------------------------------

// Historial simple de avisos del sistema al vendedor (por ahora, solo los
// pasos del ciclo de verificación/cobro) — mismos eventos que ya se mandan
// por email (ver templates/verificationUpdate.js), duplicados acá para el
// dropdown de la campanita. readAt nulo = no leída (mismo patrón que
// VendorMessage.readAt: se marca leída cuando el vendedor abre el dropdown,
// no cuando se crea la fila).
enum VendorNotificationType {
  VERIFICATION_DOCS_APPROVED
  VERIFICATION_DOCS_REJECTED
  VERIFICATION_PAYMENT_LINK_SENT
  VERIFICATION_VERIFIED
  // Bloque 46: el admin revoca el Plan Business desde Suscripciones — mismo
  // canal (email + campanita) que el resto del ciclo de verificación/cobro.
  VERIFICATION_BUSINESS_REVOKED
  // Bloque 62: suspensión automática por inactividad (90 días) — así queda
  // visible en la campanita del panel si el vendedor vuelve a intentar
  // entrar, no solo en el correo que ya recibió.
  VENDOR_SUSPENDED
  // Bloque 64: cobro recurrente del Plan Business — distintos de
  // VENDOR_SUSPENDED de arriba (esa es por inactividad de LOGIN, esta es por
  // el ciclo de pago de la verificación).
  VERIFICATION_PAYMENT_FAILED
  VERIFICATION_SUSPENDED
  // Bloque 145 (pedido explícito): la aprobación inicial de documentos
  // vence a las 24h si no se completa el pago — ver
  // expireStalePendingPaymentApprovals (verificationPayment.job.js).
  VERIFICATION_APPROVAL_EXPIRED
  // Bloque 150 (pedido explícito): Stripe confirmó el cobro (webhook) pero
  // ya NO activa la verificación solo — el vendedor todavía tiene que subir
  // la captura del pago (o marcar que no pudo) para que un admin finalice.
  VERIFICATION_STRIPE_PAID
  // Bloque 151 (pedido explícito — "también se podrá cambiar desde el panel
  // de administrador... o restablecerlo para que él pueda seleccionar otro
  // diferente"): el admin limpió el método de pago elegido — el vendedor
  // tiene que volver a elegir desde su panel.
  VERIFICATION_PAYMENT_METHOD_RESET
  // Bloque 153 (pedido explícito): un admin confirmó el pago de una
  // RENOVACIÓN (meses extra pagados mientras la tienda ya estaba
  // verificada) — distinto de VERIFICATION_VERIFIED (esa es la primera
  // activación real, con un mensaje que no aplica acá).
  SUBSCRIPTION_RENEWAL_CONFIRMED
  // Bloque 153 (pedido explícito — "si se desea cambiar el nombre o algo o
  // responsable se debe enviar la solicitud al admin"): desenlace de una
  // solicitud de cambio a datos de identidad de una tienda ya verificada
  // (el aviso de que SE ENVIÓ, al admin, usa notifyAdminActionNeeded como
  // el resto de "algo necesita revisión" — esto es solo la respuesta).
  VENDOR_CHANGE_REQUEST_APPROVED
  VENDOR_CHANGE_REQUEST_REJECTED
  // Feature B (pedido explícito): ciclo de un reporte de fraude sobre una
  // tienda o alguno de sus productos — 3 pasos visibles en la campanita del
  // vendedor, mismo criterio que el resto del ciclo de verificación/cobro.
  FRAUD_REPORT_EVIDENCE_REQUESTED
  FRAUD_REPORT_DISMISSED
  FRAUD_REPORT_SUSPENDED
  // Bloque 199 (pedido explícito — "si se queda sin stock de un producto se
  // le notifica al admin y podrá reasignar inventario nuevo"): un usuario de
  // sistema intentó vender más de lo que le queda reclamado.
  VENDOR_STAFF_OUT_OF_STOCK
  // Bloque 231 (pedido explícito — "cuando un cliente envía un pedido se
  // debe notificar en tiempo real en el panel del vendedor"): antes un
  // pedido normal (no de mesa) nunca generaba ninguna VendorNotification —
  // solo los pedidos de mesa tenían aviso propio (NewOrderPopup.jsx).
  NEW_ORDER
}

model VendorNotification {
  id        String                 @id @default(cuid())
  vendorId  String
  type      VendorNotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime               @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Reseñas, direcciones, favoritos
// ---------------------------------------------------------------------------

// Bloque 69 (pedido explícito): ciclo de vida de un reporte sobre una reseña
// — null (sin fila, ver Review.reportStatus más abajo) = nunca se reportó.
// REPORTED: alguien (vendedor o cliente) la reportó — se oculta sola en el
// momento y espera revisión del admin. KEPT: el admin revisó y decidió
// mantenerla — vuelve a ser visible y queda "sellada" contra nuevos reportes
// (ver assertReportable en reviews.controller.js). SUSPENDED: el admin
// revisó y decidió suspenderla — sigue oculta, y desde acá solo el admin
// puede borrarla de verdad (ver deleteReview, ya existente).
enum ReviewReportStatus {
  REPORTED
  KEPT
  SUSPENDED
}

model Review {
  id        String   @id @default(cuid())
  productId String?
  vendorId  String?
  // Nullable: no hace falta romper reseñas ya sembradas sin cuenta asociada.
  // Toda reseña NUEVA (reviews.controller.js) sí la trae siempre — es lo que
  // permite detectar "compra verificada" y, a futuro, evitar reseñas
  // duplicadas del mismo cliente.
  userId    String?
  authorName String
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())

  // true si el autor tiene al menos un pedido (no cancelado) con esta
  // tienda al momento de comentar — calculado una sola vez al crear la
  // reseña, no se recalcula después (igual que un "verified purchase" de
  // cualquier otro marketplace).
  isVerifiedPurchase Boolean @default(false)
  // Bloque 52: fotos reales del cliente adjuntas a la reseña — solo
  // disponibles en tiendas verificadas (ver reviews.controller.js), nunca un
  // link externo (a diferencia de las imágenes de producto/oferta, acá
  // siempre son archivos subidos al propio servidor). Ocultar/eliminar la
  // reseña (isHidden/delete de abajo) oculta/elimina estas imágenes también,
  // porque viven en la misma fila — no hace falta lógica aparte.
  images    String[] @default([])
  // Bloque 22: el admin puede ocultar un comentario sin borrarlo (o
  // borrarlo directo) — el vendedor no puede tocar ninguna de las dos cosas,
  // pero sí responder públicamente (ver vendorReply).
  isHidden  Boolean  @default(false)
  vendorReply     String?
  vendorRepliedAt DateTime?

  // Bloque 69 (pedido explícito): reporte de un comentario — por el
  // vendedor de la tienda (desde su panel) o por cualquier cliente logueado
  // (desde donde vea la reseña, nunca sobre su propio comentario). Reportar
  // oculta la reseña de inmediato (isHidden:true) y notifica al admin — el
  // admin es quien decide después si la mantiene (reportStatus:"KEPT",
  // vuelve a ser visible y no se puede volver a reportar) o la suspende
  // (reportStatus:"SUSPENDED", sigue oculta, solo el admin puede borrarla).
  reportStatus       ReviewReportStatus?
  reportedById       String?
  reportReason       String?
  reportedAt         DateTime?
  reportResolvedById String?
  reportResolvedAt   DateTime?

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reportedBy       User? @relation("ReviewReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  reportResolvedBy User? @relation("ReviewReportResolvedBy", fields: [reportResolvedById], references: [id], onDelete: SetNull)
}

model Address {
  id             String   @id @default(cuid())
  userId         String
  label          String?
  provinceId     String
  municipalityId String?
  addressLine    String
  phone          String?
  isDefault      Boolean  @default(false)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  province     Province      @relation(fields: [provinceId], references: [id])
  municipality Municipality? @relation(fields: [municipalityId], references: [id])
}

// Bloque 22: además de favoritear un producto (como ya estaba), ahora
// también se puede favoritear una tienda entera — mismo modelo, mismo
// patrón "dual nullable FK" que Review (productId/vendorId), con la
// diferencia de que acá es obligatorio exactamente uno de los dos
// (validado en favorites.controller.js, no hay fila "huérfana" de ambos
// null como sí puede pasar en Review con un comentario general de tienda).
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  vendorId  String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, vendorId])
}

// Venta rápida: un cliente SIN tienda puede publicar hasta 5 anuncios
// (límite validado en customerListings.controller.js, no acá — mismo
// criterio que el límite de plan REGULAR en products.controller.js).
// Mirror deliberadamente reducido de Product — el pedido original listó
// explícitamente imagen/título/descripción/precio, no categoría/tags/
// stock/tallas/métodos de pago (es un anuncio clasificado simple, no un
// producto de catálogo). Sin slug: la URL pública usa el id, es contenido
// efímero (30 días) que no necesita una URL permanente/SEO.
model CustomerListing {
  id          String          @id @default(cuid())
  ownerId     String
  name        String
  description String
  price       Decimal         @db.Decimal(12, 2)
  currency    ProductCurrency @default(USD)
  images      String[]        @default([])
  // Igual semántica que Product.isActive: false hasta que suba la primera
  // foto (ver activatedAt); también se pone en false si el admin lo
  // suspende (ver Report/fraudReports.job.js).
  isActive    Boolean         @default(false)
  activatedAt DateTime?
  // El dueño lo marca manualmente al vender — no borra el cupo de 5 hasta
  // que además lo elimina (puede querer dejarlo un tiempo como referencia).
  isSold      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  // Fijado UNA sola vez al crear (createdAt + 30 días) — nunca se recalcula
  // en un update. Si editar reseteara el plazo, el cliente podría evadir la
  // rotación de 30 días editando en loop.
  expiresAt   DateTime

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([ownerId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Feature B (pedido explícito): reportes de fraude sobre producto/tienda/
// venta rápida. Patrón "exactamente uno de estos 3 campos" — mismo criterio
// que Favorite (productId/vendorId), extendido a customerListingId acá.
// screenshotUrl y message son OBLIGATORIOS los dos (pedido explícito: "debe
// enviar captura Y mensaje, ambos obligatorios para poder decidir"). El
// reporte no reimplementa suspender/editar/eliminar — reusa los endpoints
// admin que ya existen sobre Product/Vendor, y los nuevos sobre
// CustomerListing; solo fraudReports.job.js actúa directo (sin admin
// presente) cuando vence el plazo de evidencia sin respuesta.
// ---------------------------------------------------------------------------
enum ReportStatus {
  PENDING
  EVIDENCE_REQUESTED
  RESOLVED_NO_ACTION
  RESOLVED_SUSPENDED
  DISMISSED
}

model Report {
  id         String  @id @default(cuid())
  reporterId String
  productId  String?
  vendorId   String?
  customerListingId String?

  // Obligatorios los dos al crear (ver reports.controller.js) — es lo que
  // permite al admin decidir sin tener que pedirle más datos al reportante
  // antes de poder evaluar.
  screenshotUrl String
  message       String @db.Text

  status ReportStatus @default(PENDING)

  // Se setea al pedir evidencia (requestEvidence en adminReports.controller.js)
  // — fraudReports.job.js es quien realmente actúa cuando se vence.
  evidenceRequestedAt DateTime?
  evidenceDueAt       DateTime?
  // Respuesta del reportado (vendedor o dueño de la venta rápida) — mismo
  // criterio que las fotos de reseña: archivos subidos, nunca un link.
  evidenceMessage String?   @db.Text
  evidenceImages  String[]  @default([])
  evidenceSentAt  DateTime?

  // autoResolved:true = lo resolvió fraudReports.job.js solo (venció el
  // plazo sin respuesta) — mismo criterio que byAdminId:null en
  // vendorLifecycle.job.js. resolvedById queda null en ese caso.
  autoResolved   Boolean   @default(false)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?   @db.Text

  createdAt DateTime @default(now())

  reporter         User             @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy       User?            @relation("ReportsResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  product          Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor           Vendor?          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customerListing  CustomerListing? @relation(fields: [customerListingId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
  @@index([productId])
  @@index([vendorId])
  @@index([customerListingId])
  @@index([evidenceDueAt])
}

// Bloque 21: chatbot IA por tienda verificada. Sin login — el cliente se
// identifica solo por sessionId (uuid generado en el navegador, guardado en
// localStorage), así que no hay userId acá. role es "user" o "model" (mismos
// nombres que la API de Gemini, para armar el array de `contents` del
// próximo turno sin tener que traducir nada).
model ChatMessage {
  id        String   @id @default(cuid())
  vendorId  String
  sessionId String
  role      String
  content   String
  // Bloque 24: IDs de producto que el bot mencionó/recomendó en este
  // mensaje (solo role="model" — un mensaje "user" siempre queda en []).
  // Ya filtrados contra el catálogo real antes de guardarse (nunca un ID
  // alucinado) — se persisten para que reabrir el chat siga mostrando las
  // mismas tarjetas de producto sin tener que volver a llamar al modelo.
  productIds String[] @default([])
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, sessionId])
}

// ---------------------------------------------------------------------------
// Bloque 30: bot general del marketplace (Home) — distinto del chat por
// tienda de arriba (siempre ligado a un vendorId). Este vive a nivel
// plataforma: sin vendorId, con userId opcional (solo se completa si el
// cliente está logueado — hace falta para el límite diario de fotos).
// ---------------------------------------------------------------------------

model MarketplaceChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  role      String
  content   String
  // true solo en mensajes "user" que incluyeron una imagen — es lo que
  // cuenta contra el límite de 5 fotos/día por usuario logueado (ver
  // assistant.controller.js). Nunca se guarda la imagen en sí, solo la
  // marca de que hubo una — la imagen se descarta apenas se usa para
  // describirla, no hay valor en retenerla y sí un costo de storage/privacidad.
  hasImage   Boolean  @default(false)
  productIds String[] @default([])
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId, hasImage, createdAt])
}

// ---------------------------------------------------------------------------
// Bloque 37: aprendizaje por ejemplos curados — Groq no permite fine-tuning
// propio, así que la mejora continua de ambos bots se hace acá: el admin
// revisa conversaciones reales (AdminAssistant.jsx), marca una respuesta
// como "mala" y escribe la ideal (o marca una "buena" para reforzarla tal
// cual salió) — cada fila es un par entrada->respuesta que se inyecta como
// few-shot real en el prompt del bot correspondiente (ver
// buildFewShotExamples en assistant.controller.js/chat.controller.js),
// nunca inventado por el modelo. "activo" permite desactivar un ejemplo sin
// borrar el historial de qué se corrigió.
// ---------------------------------------------------------------------------

model ChatTrainingExample {
  id             String      @id @default(cuid())
  botTipo        ChatBotType
  entradaCliente String
  respuestaIdeal String
  activo         Boolean     @default(true)
  creadoPorId    String?
  createdAt      DateTime    @default(now())

  creadoPor User? @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([botTipo, activo, createdAt])
}

// Documentos que el admin sube para entrenar al bot general (info
// institucional: cómo comprar, cómo vender, verificación, planes, etc.) — a
// diferencia de Vendor.aiDocument (uno por tienda, se reemplaza), acá se
// permiten VARIOS documentos a la vez (ej. uno para clientes, otro para
// vendedores) — todos se leen juntos en cada request del bot general.
model AssistantDocument {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Bloque 23: "Solicitar este producto" — registro de interés en un producto
// sin stock (no es un pedido, no pasa por carrito/checkout). El vendedor lo
// usa en VendorProducts.jsx para priorizar qué reponer primero.
// ---------------------------------------------------------------------------

// Cliente logueado -> customerId. Sin login -> guestId, mismo patrón de
// identidad anónima que ChatMessage.sessionId (uuid generado en el navegador,
// persistido en localStorage) — se prefiere sobre pedir un email a mano,
// que exigiría un formulario y contradice el "un solo click, sin fricción"
// pedido. Nunca ambos null (products.controller.js lo valida). El par
// (productId, customerId|guestId) dentro de una ventana de 24h es lo que usa
// requestProductRestock para no contar de nuevo el mismo click repetido.
model ProductRequest {
  id         String   @id @default(cuid())
  productId  String
  vendorId   String
  customerId String?
  guestId    String?
  createdAt  DateTime @default(now())

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customer User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([vendorId, createdAt])
}

// ---------------------------------------------------------------------------
// Bloque 48: páginas legales/ayuda editables desde el admin — sin fila =
// copy fijo del componente React (nunca se pierde el contenido original);
// con htmlContent = el admin pisó ese texto con HTML propio (sanitizado
// server-side antes de guardar, ver static_pages.controller.js).
// ---------------------------------------------------------------------------

model StaticPage {
  slug        String    @id // "terminos" | "privacidad" | "ayuda" | "contacto"
  htmlContent String?
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Bloque 53: preguntas frecuentes reales (antes eran copy hardcodeado en
// Faq.jsx, sin fila propia en DB) — sección aparte del admin, separada de
// "Páginas" (que ahora solo sirve para Términos/Privacidad). Cada pregunta
// pertenece a UN público (cliente o vendedor), nunca a ambos a la vez — el
// FAQ público muestra una lista distinta según la pestaña activa.
// ---------------------------------------------------------------------------

enum FaqAudience {
  CUSTOMER
  VENDOR
}

model FaqItem {
  id        String      @id @default(cuid())
  audience  FaqAudience
  question  String
  answer    String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([audience, createdAt])
}

// ---------------------------------------------------------------------------
// Bloque 50: ofertas de vendedor — se arman sobre un producto YA existente
// de esa tienda (nunca un producto nuevo desde cero), solo tiendas
// verificadas, una oferta nueva por vendedor cada 7 días (validado contra
// createdAt de la última Offer del vendedor, sin importar su status —
// retirarla antes de tiempo no libera el límite semanal, ver pedido
// explícito del bloque), vigentes 30 días desde startsAt. ACTIVE -> EXPIRED
// lo decide un chequeo perezoso al leer (nunca un cron aparte todavía) — ver
// offers.controller.js.
// ---------------------------------------------------------------------------

// Bloque 51: SUSPENDED se suma a los 3 originales — es el admin ocultando
// una oferta (propia o de un vendedor) por incumplimiento de políticas, sin
// borrarla (el vendedor la sigue viendo en su historial, marcada como tal).
// Distinto de REMOVED (el propio vendedor la retira) y de EXPIRED (venció
// sola) — los tres dejan de mostrarse en el Home, pero solo un admin puede
// poner/sacar SUSPENDED.
enum OfferStatus {
  ACTIVE
  EXPIRED
  REMOVED
  SUSPENDED
}

// PRODUCT: sobre un producto ya cargado (imageUrl = una de su galería).
// CUSTOM: imagen propia subida por el vendedor/admin, sin producto asociado.
// HTML: bloque HTML insertado tal cual — EXCLUSIVO del admin (nunca
// disponible para vendedores, ver offers.controller.js/adminOffers.controller.js).
enum OfferContentType {
  PRODUCT
  CUSTOM
  HTML
}

enum OfferOrientation {
  VERTICAL
  HORIZONTAL
}

// Bloque 65: se reusa el mismo enum para Vendor.currency (moneda operativa
// única de la tienda, elegida en el registro) — mismo concepto que
// Product.currency (en qué moneda está expresado un precio puntual), nunca
// dos enums paralelos para la misma idea. MXN nuevo a pedido explícito.
enum ProductCurrency {
  CUP
  USD
  EUR
  MXN
}

model Offer {
  id             String           @id @default(cuid())
  // Bloque 51: null = oferta creada por el admin desde la nueva sección
  // "Ofertas" del panel admin — no pertenece a ninguna tienda.
  vendorId       String?
  // Bloque 51: null cuando contentType es CUSTOM o HTML (no hay producto
  // asociado) — antes era obligatorio, solo existía el caso PRODUCT.
  productId      String?
  contentType    OfferContentType @default(PRODUCT)
  orientation    OfferOrientation @default(HORIZONTAL)
  title          String
  // Bloque 51: antes no existía — solo tenía sentido para ofertas PRODUCT
  // (mostraban el nombre del producto). Ahora las CUSTOM/HTML necesitan su
  // propio texto libre.
  description    String?          @db.Text
  tagline        String?
  discountLabel  String?
  // Requerido si contentType es PRODUCT o CUSTOM (archivo subido o, para
  // PRODUCT, una de las imágenes ya cargadas del producto). Null si
  // contentType es HTML — ahí el contenido entero vive en htmlContent.
  imageUrl       String?
  // Bloque 51: EXCLUSIVO de ofertas creadas por el admin (contentType
  // HTML) — nunca aceptado desde el endpoint de vendedor.
  htmlContent    String?          @db.Text
  // Bloque 192 (pedido explícito — "al crear una oferta desde admin, el
  // admin puede agregar un botón a la oferta y un enlace también"):
  // EXCLUSIVO de ofertas creadas por el admin, igual que htmlContent —
  // nunca aceptado desde el endpoint de vendedor (offers.controller.js,
  // createOfferSchema/updateOfferSchema no los incluyen). Ambos o ninguno
  // en la práctica (el botón sin destino no tiene sentido) — se valida en
  // adminOffers.controller.js, no acá. `buttonUrl` acepta tanto un link
  // interno relativo ("/tienda/mi-tienda") como uno externo absoluto
  // ("https://...") — OffersSlider.jsx decide cuál de los dos es al
  // renderizar.
  buttonLabel    String?
  buttonUrl      String?
  createdByAdmin Boolean          @default(false)
  status         OfferStatus      @default(ACTIVE)
  startsAt       DateTime         @default(now())
  // Bloque 51: null = nunca vence (SOLO permitido si createdByAdmin —
  // las ofertas de vendedor siempre tienen que traer una fecha real, para
  // que la sección "Ofertas" del Home nunca dependa de una limpieza manual).
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  winbackEmailLogs WinbackEmailLog[]

  @@index([vendorId, createdAt])
  @@index([status, expiresAt])
}

// ---------------------------------------------------------------------------
// Bloque 52: códigos de descuento del vendedor, aplicables en el carrito
// (ver orders.controller.js: resolveDiscountForOrder/createOrder), y ofertas
// de tienda (StoreOffer, más abajo) — distintas de Offer de arriba (esas son
// la sección "Ofertas" del Home; StoreOffer vive dentro de la página pública
// de cada tienda, ver Store.jsx). Sin gate de isVerified: a diferencia de
// Offer, cualquier vendedor (Regular o Business) puede usar ambas funciones.
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model DiscountCode {
  id       String       @id @default(cuid())
  vendorId String
  // Siempre en mayúsculas (normalizado en discountCodes.controller.js) — el
  // vendedor lo escribe o se genera automático si lo deja vacío. Único por
  // TIENDA, no global: dos vendedores distintos pueden tener el mismo texto.
  code     String
  type     DiscountType
  // Porcentaje (0-100) si type es PERCENTAGE, monto en CUP si FIXED_AMOUNT —
  // nunca ambos a la vez, mismo criterio que un radio button en el form.
  value    Decimal      @db.Decimal(12, 2)
  // Mínimo/máximo de SUBTOTAL del carrito (de los productos de ESTA tienda)
  // para que el código aplique — ambos opcionales, validados en el
  // formulario (max > min si los dos están presentes).
  minPurchase Decimal?  @db.Decimal(12, 2)
  maxPurchase Decimal?  @db.Decimal(12, 2)
  // null = usos ilimitados. usesCount se incrementa atómicamente (updateMany
  // con condición usesCount < maxUses) al confirmar un pedido que lo usa —
  // ver createOrder — para que dos clientes usando el último cupo casi al
  // mismo tiempo no dejen el contador por encima del límite.
  maxUses   Int?
  usesCount Int      @default(0)
  startsAt  DateTime @default(now())
  // null = nunca vence (el vendedor lo desactiva manualmente con `active`).
  expiresAt DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  vendor Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  offers StoreOffer[]
  orders Order[]

  @@unique([vendorId, code])
}

model StoreOffer {
  id             String   @id @default(cuid())
  vendorId       String
  title          String
  // Puede escribirse a mano o mejorarse con IA (kind "offer" de
  // ai.controller.js/aiPrompts.js, ya usado por las ofertas del Home).
  description    String?  @db.Text
  discountCodeId String
  isLimitedTime  Boolean  @default(false)
  // Bloque 232 (pedido explícito — "se puede programar cuándo empieza una
  // y cuándo termina"): null = arranca apenas se activa (comportamiento de
  // siempre); con fecha, la oferta puede crearse/activarse de antemano pero
  // no se muestra en la tienda pública (ver getVendorBySlug,
  // vendors.controller.js) hasta llegar a esa fecha. Igual que expiresAt,
  // solo tiene sentido con isLimitedTime — nunca los dos por separado.
  startsAt       DateTime?
  // Obligatorio si isLimitedTime es true (validado en storeOffers.controller.js).
  expiresAt      DateTime?
  // Bloque 52: true cuando el código se creó desde "Crear código nuevo para
  // esta oferta" en vez de reusar uno ya existente — al vencer esta oferta
  // (ver expireStaleStoreOffers), el código exclusivo se desactiva junto con
  // ella; uno reusado de otras ofertas/promos nunca se toca automáticamente.
  discountCodeExclusive Boolean @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)

  @@index([vendorId, active])
}

// ---------------------------------------------------------------------------
// Bloque 54: carrito persistente por cuenta (cliente logueado) + carritos
// compartibles por enlace. Distintos conceptos: CartSnapshot es SIEMPRE del
// dueño de la cuenta (una fila por usuario, se sobrescribe en cada cambio,
// se lee al iniciar sesión en otro dispositivo — ver cart.controller.js);
// SharedCart es un snapshot de UN SOLO USO público (cualquiera con el link,
// logueado o no, ver sharedCart.controller.js) que se resuelve contra el
// catálogo REAL al leerse (precio/stock vigentes, nunca los del momento en
// que se compartió).
// ---------------------------------------------------------------------------

model CartSnapshot {
  id       String @id @default(cuid())
  userId   String @unique
  // Metadata de la tienda (id/nombre/slug/color/verificado/whatsapp) tal
  // cual la guarda CartContext.jsx — evita otra consulta a /vendors/:slug
  // solo para pintar el carrito apenas se restaura en un dispositivo nuevo.
  vendorMeta Json?
  // [{ productId, name, price, currency, size, quantity, stock, selectedOptions }]
  items    Json
  // { code, type, value, amount } tal cual lo devuelve /discount-codes/validate
  // — se vuelve a revalidar igual al confirmar el pedido, esto es solo lo
  // que se muestra mientras tanto.
  discount Json?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SharedCart {
  id        String   @id @default(cuid())
  vendorId  String
  // [{ productId, quantity, size }] — SIN precio/nombre a propósito: se
  // resuelven contra el Product real recién al abrir el link (ver
  // getSharedCart), así un link viejo nunca muestra un precio vencido ni
  // deja comprar más de lo que hay de stock hoy.
  items     Json
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}
