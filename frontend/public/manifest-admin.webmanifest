{
  "id": "/admin?app=admin",
  "name": "Baznova Admin",
  "short_name": "Baznova Admin",
  "description": "Administración de la plataforma con avisos de lo que necesita revisión.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/admin?source=pwa",
  "scope": "/admin",
  "display": "standalone",
  "related_applications": [{ "platform": "webapp", "url": "/manifest-admin.webmanifest" }],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0b1219",
  "theme_color": "#0b1219",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}