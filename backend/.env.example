# Plantilla documentada — copiar a .env.development para desarrollo local.
# La app (env.js) carga .env.<NODE_ENV> si existe (ej. .env.development) y
# si no cae a .env a secas. Los comandos de Prisma CLI (migrate/seed/studio)
# siempre leen el .env plano de la raíz de backend/ — mantenelo igual a
# .env.development mientras solo exista un entorno.
# Cuando llegue el momento del VPS: crear .env.production (nunca commitear
# ninguno de los tres, solo este .env.example).

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# postgresql://<rol_app>:<password>@<host>:5432/<db>?schema=public
# NUNCA uses el superusuario "postgres" acá — creá un rol dedicado (ver README).
DATABASE_URL="postgresql://zeudin_app:CHANGE_ME@localhost:5432/zeudin?schema=public"

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Clave AES-256 (32 bytes en hex, 64 caracteres) para cifrar credenciales de
# integraciones guardadas en la tabla Integration. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_ENCRYPTION_KEY=

# Nota: la clave de Resend (y Gemini/Groq/Stripe) NO se lee de acá — se
# guarda cifrada (AES-256-GCM) en la tabla Integration vía el panel de
# admin (Integraciones). Por eso no hay RESEND_API_KEY en este archivo.

# Opcional: solo si querés respaldar a una carpeta/cantidad distinta de la
# default en scripts/backup.js (ver "npm run db:backup").
# BACKUP_DIR=
# BACKUP_KEEP_LAST=14
# PG_DUMP_PATH=
