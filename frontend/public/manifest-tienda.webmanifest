{
  "id": "/vendedor?app=tienda",
  "name": "Baznova Tienda",
  "short_name": "Baznova Tienda",
  "description": "Panel de tu tienda: pedidos, productos, caja y avisos al instante.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/vendedor?source=pwa",
  "scope": "/vendedor",
  "display": "standalone",
  "related_applications": [{ "platform": "webapp", "url": "/manifest-tienda.webmanifest" }],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0e1a28",
  "theme_color": "#0e1a28",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}